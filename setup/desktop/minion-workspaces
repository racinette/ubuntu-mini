#!/usr/bin/python3
"""Keep child windows with their origin and compact empty numbered workspaces."""
import json
import logging
import os
from pathlib import Path
import re
import signal
import subprocess


def enabled():
    config = {}
    for path in (Path('/etc/minion/gamepad.json'), Path.home() / '.config/minion/gamepad.json'):
        if path.exists():
            config.update(json.loads(path.read_text()))
    return config.get('workspace_numbers') is None


def normalize():
    workspaces = json.loads(subprocess.check_output(['swaymsg', '-r', '-t', 'get_workspaces']))
    numbered = sorted((w for w in workspaces if w['num'] > 0), key=lambda w: w['num'])
    # Duplicate numeric prefixes belong to a personal naming scheme.
    if len({w['num'] for w in numbered}) != len(numbered):
        return
    commands = []
    for number, workspace in enumerate(numbered, 1):
        if workspace['num'] != number:
            name = re.sub(r'^[0-9]+', str(number), workspace['name'], count=1)
            commands.append(f'rename workspace {json.dumps(workspace["name"])} to {json.dumps(name)}')
    if commands:
        result = json.loads(subprocess.check_output(['swaymsg', '-r', '; '.join(commands)]))
        if not all(item.get('success') for item in result):
            raise RuntimeError('Sway refused workspace renumbering: ' + str(result))


def workspace_state(tree):
    def focused(node):
        return node.get('focused', False) or any(focused(child) for child in
            node.get('nodes', []) + node.get('floating_nodes', []))

    def collect(node):
        if node.get('type') == 'workspace':
            if node.get('name') == '__i3_scratch':
                return []
            return [dict(node, occupied=bool(node.get('nodes') or node.get('floating_nodes')),
                         focused=focused(node))]
        return [workspace for child in node.get('nodes', []) + node.get('floating_nodes', [])
                for workspace in collect(child)]

    workspaces = collect(tree)
    last = max((w['num'] for w in workspaces if w['num'] > 0 and w['occupied']), default=0) + 1
    current = next((w['num'] for w in workspaces if w['focused']), -1)
    return {'workspaces': workspaces, 'last': last, 'current': current}


def workspace_target(current, step, last):
    if current < 1:
        return 1
    if current == 1 and step < 0:
        # Backward wrap skips the extra empty slot; forward navigation offers it.
        return max(1, last - 1)
    if current > last:
        return 1 if step > 0 else last
    return (current - 1 + step) % last + 1


def parent_pids(pid, proc=Path('/proc')):
    """Read live ancestry without shell parsing or crossing account boundaries."""
    seen = set()
    for depth in range(128):
        if type(pid) is not int or pid <= 1 or pid in seen:
            return
        seen.add(pid)
        try:
            process = proc / str(pid)
            if process.stat().st_uid != os.getuid():
                return
            try:
                args = (process / 'cmdline').read_bytes().split(b'\0')
                if Path(os.fsdecode(args[0])).name == 'codex' and b'app-server' in args[1:4]:
                    return  # The backend can serve terminals on many workspaces.
            except OSError:
                pass
            if depth:
                yield pid
            # comm can contain spaces and parentheses; ppid follows its final ')'.
            fields = (process / 'stat').read_text().rsplit(')', 1)[1].split()
            pid = int(fields[1])
        except (OSError, ValueError, IndexError):
            return


def window_origin(tree, window_id, ancestry=parent_pids):
    windows = {}
    target = None

    def collect(node, workspace=None):
        nonlocal target
        if node.get('type') == 'workspace':
            workspace = node
        if node.get('pid') and workspace:
            if node['id'] == window_id:
                target = (node, workspace)
            elif workspace.get('name') != '__i3_scratch':
                windows.setdefault(node['pid'], []).append(workspace)
        for child in node.get('nodes', []) + node.get('floating_nodes', []):
            collect(child, workspace)

    collect(tree)
    if target is None or target[1].get('name') == '__i3_scratch':
        return
    node, current = target
    # A shared application process gives no evidence of which window launched
    # another one. Leave its placement to startup notification/the application.
    if node['pid'] in windows:
        return
    for pid in ancestry(node['pid']):
        candidates = windows.get(pid, [])
        if candidates:
            if len({workspace['id'] for workspace in candidates}) != 1:
                return  # Shared-server ancestors on different workspaces.
            origin = candidates[0]
            return origin if origin['id'] != current['id'] else None


def reaper_fx_placement(tree, window_id):
    """Tile native FX tools and follow an active, explicit transient parent.

    REAPER shares a PID between project and FX windows. WM_TRANSIENT_FOR gives
    the exact parent where process ancestry cannot identify a workspace.
    """
    windows,by_xid={},{}
    focused_workspace=None
    def collect(node,workspace=None):
        nonlocal focused_workspace
        if node.get('type')=='workspace':workspace=node
        if workspace and node.get('focused'):focused_workspace=workspace
        if workspace and node.get('pid'):
            windows[node['id']]=(node,workspace)
            if node.get('window'):by_xid[node['window']]=(node,workspace)
        for child in node.get('nodes',[])+node.get('floating_nodes',[]):collect(child,workspace)
    collect(tree)
    if window_id not in windows:return
    node,current=windows[window_id]
    props=node.get('window_properties') or {}
    if props.get('class')!='REAPER' or not re.match(r'^(FX:|VSTi?:|VST3:|JS:)',node.get('name') or ''):
        return
    parent=by_xid.get(props.get('transient_for'))
    if not parent:return
    owner,workspace=parent
    if owner['pid']!=node['pid'] or workspace.get('name')=='__i3_scratch':return
    commands=[]
    if workspace['id']!=current['id']:
        commands.append('move container to workspace '+json.dumps(workspace['name']))
    commands.append('floating disable')
    if (focused_workspace and focused_workspace['id']==workspace['id']
            and (owner.get('focused') or node.get('focused'))):
        commands.append('focus')
    return '[con_id='+str(window_id)+'] '+', '.join(commands)


def reaper_tabbed_window(tree, window_id):
    """Use full-size tabs for project/FX/controller surfaces, not modal dialogs."""
    if tree.get('id') == window_id:
        props = tree.get('window_properties') or {}
        title = tree.get('name') or ''
        return props.get('class') == 'REAPER' and bool(
            re.search(r' - REAPER v[0-9]', title)
            or re.match(r'^(FX:|VSTi?:|VST3:|JS:)', title)
            or title in ('Device gamepad', 'REAPER gamepad controls'))
    return any(reaper_tabbed_window(child, window_id) for child in
               tree.get('nodes', []) + tree.get('floating_nodes', []))


def place_child_window(window_id):
    if type(window_id) is not int or window_id <= 0:
        return
    tree = json.loads(subprocess.check_output(['swaymsg', '-r', '-t', 'get_tree']))
    command=reaper_fx_placement(tree,window_id)
    if command is None:
        origin = window_origin(tree, window_id)
        if origin:
            command = f'[con_id={window_id}] move container to workspace {json.dumps(origin["name"])}'
    if reaper_tabbed_window(tree, window_id):
        # Apply after origin placement: an FX created on another workspace must
        # not change that workspace's layout before moving to its parent.
        command = command + ', layout tabbed' if command else f'[con_id={window_id}] layout tabbed'
    if command:
        result = json.loads(subprocess.check_output(['swaymsg', '-r', command]))
        if not all(item.get('success') for item in result):
            raise RuntimeError('Sway refused child window placement')


def main():
    def stop(*_):
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, stop)
    # Only place newly opened windows; subsequent user moves remain untouched.
    process = subprocess.Popen(['swaymsg', '-m', '-r', '-t', 'subscribe', '["workspace","window"]'],
                               stdout=subprocess.PIPE, text=True)
    try:
        if enabled():
            normalize()
        for line in process.stdout:
            event = json.loads(line)
            if event.get('change') == 'new':
                try:
                    place_child_window(event.get('container', {}).get('id'))
                except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
                    logging.warning('Could not place child window: %s', error)
            if event.get('change') in ('init', 'empty', 'rename') and enabled():
                normalize()
        raise RuntimeError('Sway workspace subscription ended')
    finally:
        process.terminate()
        process.wait(timeout=3)


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        logging.error('%s', error)
        raise SystemExit(1)
