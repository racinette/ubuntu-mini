#!/usr/bin/python3
"""Control display power/refresh and the session's explicit keep-awake override."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import subprocess
import tempfile
import time


def state_directory():
    directory = Path(os.environ['XDG_RUNTIME_DIR']) / 'minion-idle'
    directory.mkdir(mode=0o700, exist_ok=True)
    return directory


def set_display_power(enabled):
    if enabled:
        output = subprocess.check_output(['swaymsg', '-r', '-t', 'get_outputs'], text=True, timeout=5)
        if any(item.get('power') is False for item in json.loads(output)):
            # Fn+F3 may be pressed while an automatically blanked screen wakes.
            (state_directory() / 'last-display-wake').write_text(str(time.monotonic()))
    subprocess.run(['swaymsg', 'output', '*', 'power', 'on' if enabled else 'off'],
                   check=True, timeout=5, stdout=subprocess.DEVNULL)


def display_power(enabled, automatic=False):
    directory = state_directory()
    with (directory / 'control.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        manual = directory / 'manual-display-off'
        if not automatic:
            if enabled:
                manual.unlink(missing_ok=True)
            else:
                manual.touch(mode=0o600)
        # Activity, charger changes and lid opening must respect manual blanking.
        if enabled and (manual.exists() or (directory / 'lid-closed').exists()):
            return
        set_display_power(enabled)


BUILTIN_KEYBOARD = '1:1:AT_Translated_Set_2_keyboard'


def lid_keyboard(closed):
    # Called under control.lock. Keep the independent lid switch active so
    # reopening can restore typing without any keyboard input.
    saved = state_directory() / 'lid-keyboard-events'
    if closed:
        if not saved.exists():
            inputs = json.loads(subprocess.check_output(['swaymsg', '-r', '-t', 'get_inputs'],
                                                       text=True, timeout=5))
            keyboard = next((item for item in inputs if item.get('identifier') == BUILTIN_KEYBOARD), None)
            if keyboard is None:
                return
            mode = keyboard.get('libinput', {}).get('send_events', 'enabled')
            if mode not in ('enabled', 'disabled', 'disabled_on_external_mouse'):
                raise RuntimeError('Unrecognized built-in keyboard event setting')
            saved.write_text(mode)
            saved.chmod(0o600)
        mode = 'disabled'
    else:
        if not saved.exists():
            return
        mode = saved.read_text().strip()
        if mode not in ('enabled', 'disabled', 'disabled_on_external_mouse'):
            raise RuntimeError('Invalid saved built-in keyboard event setting')
    response = json.loads(subprocess.check_output(
        ['swaymsg', '-r', f'input "{BUILTIN_KEYBOARD}" events {mode}'], text=True, timeout=5))
    if not response or not all(item.get('success') for item in response):
        raise RuntimeError('Could not change built-in keyboard event handling')
    if not closed:
        saved.unlink()


def lid_changed(closed):
    directory = state_directory()
    with (directory / 'control.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        marker = directory / 'lid-closed'
        if closed:
            marker.touch(mode=0o600)
            lid_keyboard(True)
            set_display_power(False)
            try:
                awake = (directory / 'keep-awake').read_text().strip() == '1'
            except OSError:
                awake = False
        else:
            lid_keyboard(False)
            marker.unlink(missing_ok=True)
            if not (directory / 'manual-display-off').exists():
                set_display_power(True)
            return
    if not awake:
        # The session owns lid handling through a low-level logind inhibitor.
        # Lock synchronously before explicitly requesting normal suspend.
        subprocess.run(['minion-lock'], check=True, timeout=15)
        # Opening the lid or enabling Awake during lock startup cancels sleep.
        with (directory / 'control.lock').open('a') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            try:
                awake = (directory / 'keep-awake').read_text().strip() == '1'
            except OSError:
                awake = False
            should_suspend = marker.exists() and not awake
        if should_suspend:
            subprocess.run(['systemctl', 'suspend'], check=True, timeout=15)


def display_toggle(phase):
    directory = state_directory()
    pending = directory / 'display-toggle-pending'
    if phase == 'press':
        output = subprocess.check_output(['swaymsg', '-r', '-t', 'get_outputs'], text=True, timeout=5)
        was_off = any(item.get('power') is False for item in json.loads(output))
        try:
            age = time.monotonic() - float((directory / 'last-display-wake').read_text())
            was_off = was_off or 0 <= age < .25
        except (OSError, ValueError):
            pass
        with (directory / 'control.lock').open('a') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            temporary = pending.with_suffix('.tmp')
            temporary.write_text('on' if was_off else 'off')
            temporary.chmod(0o600)
            temporary.replace(pending)
        return
    # Press/release bindings spawn separate commands. Allow a fast key release
    # to arrive first without evaluating its action before the press snapshot.
    deadline = time.monotonic() + .25
    while True:
        with (directory / 'control.lock').open('a') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            try:
                value = pending.read_text()
                pending.unlink()
            except FileNotFoundError:
                value = None
        if value is not None:
            break
        if time.monotonic() >= deadline:
            return
        time.sleep(.01)
    if value in ('on', 'off'):
        display_power(value == 'on')
        # The snapshot has consumed the wake marker for this input sequence.
        (directory / 'last-display-wake').unlink(missing_ok=True)


def toggle_awake():
    directory = state_directory()
    target = directory / 'keep-awake'
    with (directory / 'control.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        enabled = not (target.exists() and target.read_text().strip() == '1')
        temporary = target.with_suffix('.tmp')
        temporary.write_text('1\n' if enabled else '0\n')
        temporary.chmod(0o600)
        temporary.replace(target)
    message = ('Keep awake enabled: automatic idle locking and display-off paused.'
               if enabled else 'Keep awake disabled: normal charger-aware idle policy restored.')
    subprocess.run(['notify-send', '-a', 'minion', '--', 'Keep awake', message],
                   check=False, timeout=5)
    return enabled


REFRESH_HEADER = '# Managed by minion-idle-controls: internal-panel refresh rate.\n'


def internal_output():
    data = json.loads(subprocess.check_output(['swaymsg', '-r', '-t', 'get_outputs'], text=True, timeout=5))
    return next((item for item in data if item.get('name') == 'eDP-1' and item.get('active')), None)


def set_mode(mode):
    command = f"output eDP-1 mode {mode['width']}x{mode['height']}@{mode['refresh'] / 1000:.3f}Hz"
    result = json.loads(subprocess.check_output(['swaymsg', '-r', command], text=True, timeout=5))
    if not result or not all(item.get('success') for item in result):
        raise RuntimeError('The display rejected the requested refresh rate')
    return command


def toggle_refresh(preference=None):
    preference = preference or Path.home() / '.config/sway/minion-refresh.conf'
    with (state_directory() / 'control.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if preference.is_symlink():
            raise RuntimeError('Refusing a symlinked refresh preference')
        if preference.exists() and not preference.read_text().startswith(REFRESH_HEADER):
            raise RuntimeError('The refresh preference contains personal configuration')
        output = internal_output()
        if output is None:
            raise RuntimeError('The internal display is unavailable')
        current = output['current_mode']
        target = 120000 if abs(current['refresh'] - 60000) < 1000 else 60000
        modes = [mode for mode in output['modes']
                 if mode['width'] == current['width'] and mode['height'] == current['height']
                 and abs(mode['refresh'] - target) < 1000]
        if not modes:
            raise RuntimeError(f'The internal display does not advertise {target // 1000} Hz at this resolution')
        selected = min(modes, key=lambda mode: abs(mode['refresh'] - target))
        preference.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile(mode='w', dir=preference.parent, delete=False) as stream:
            prepared = Path(stream.name)
        try:
            command = set_mode(selected)
            actual = internal_output()
            # Extra advertised-mode metadata can differ from current_mode.
            if actual is None or any(actual['current_mode'].get(key) != selected[key]
                                     for key in ('width', 'height', 'refresh')):
                raise RuntimeError('The active display mode did not match the requested rate')
            # Sway reload otherwise resets an implicit firmware rotation to
            # normal. Retain the panel geometry alongside the selected mode;
            # explicit personal output settings are included afterward.
            geometry = f" transform {output['transform']} scale {output['scale']:g}"
            prepared.write_text(REFRESH_HEADER + command + geometry + '\n')
            prepared.chmod(0o600)
            prepared.replace(preference)
        except BaseException:
            set_mode(current)
            raise
        finally:
            prepared.unlink(missing_ok=True)
    rate = round(selected['refresh'] / 1000)
    subprocess.run(['notify-send', '-a', 'minion', '-t', '2000', '--', 'Refresh rate', f'{rate} Hz'],
                   check=False, timeout=5)
    return rate


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=('off', 'on', 'wake', 'idle-off', 'lid-close', 'lid-open', 'display-press', 'display-release', 'toggle-awake', 'toggle-refresh', 'status'))
    action = parser.parse_args().action
    if action in ('off', 'on'):
        display_power(action == 'on')
    elif action in ('wake', 'idle-off'):
        display_power(action == 'wake', automatic=True)
    elif action in ('lid-close', 'lid-open'):
        lid_changed(action == 'lid-close')
    elif action in ('display-press', 'display-release'):
        display_toggle(action.removeprefix('display-'))
    elif action == 'toggle-awake':
        toggle_awake()
    elif action == 'toggle-refresh':
        try:
            toggle_refresh()
        except (OSError, ValueError, KeyError, RuntimeError, subprocess.SubprocessError) as error:
            subprocess.run(['notify-send', '-a', 'minion', '--', 'Refresh rate', str(error)],
                           check=False, timeout=5)
            parser.exit(1, f'Refresh rate: {error}\n')
    else:
        target = state_directory() / 'keep-awake'
        print(json.dumps({'keep_awake': target.exists() and target.read_text().strip() == '1'}))


if __name__ == '__main__':
    main()
