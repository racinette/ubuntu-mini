#!/usr/bin/python3
"""Compact numbered workspaces after Sway removes an empty workspace."""
import json
import logging
from pathlib import Path
import re
import signal
import subprocess


def enabled():
    config = {}
    for path in (Path('/etc/minion/gamepad.json'), Path.home() / '.config/minion/gamepad.json'):
        if path.exists():
            config.update(json.loads(path.read_text()))
    return config.get('workspace_numbers') is None


def normalize():
    workspaces = json.loads(subprocess.check_output(['swaymsg', '-r', '-t', 'get_workspaces']))
    numbered = sorted((w for w in workspaces if w['num'] > 0), key=lambda w: w['num'])
    # Duplicate numeric prefixes belong to a personal naming scheme.
    if len({w['num'] for w in numbered}) != len(numbered):
        return
    commands = []
    for number, workspace in enumerate(numbered, 1):
        if workspace['num'] != number:
            name = re.sub(r'^[0-9]+', str(number), workspace['name'], count=1)
            commands.append(f'rename workspace {json.dumps(workspace["name"])} to {json.dumps(name)}')
    if commands:
        result = json.loads(subprocess.check_output(['swaymsg', '-r', '; '.join(commands)]))
        if not all(item.get('success') for item in result):
            raise RuntimeError('Sway refused workspace renumbering: ' + str(result))


def workspace_state(tree):
    def focused(node):
        return node.get('focused', False) or any(focused(child) for child in
            node.get('nodes', []) + node.get('floating_nodes', []))

    def collect(node):
        if node.get('type') == 'workspace':
            if node.get('name') == '__i3_scratch':
                return []
            return [dict(node, occupied=bool(node.get('nodes') or node.get('floating_nodes')),
                         focused=focused(node))]
        return [workspace for child in node.get('nodes', []) + node.get('floating_nodes', [])
                for workspace in collect(child)]

    workspaces = collect(tree)
    last = max((w['num'] for w in workspaces if w['num'] > 0 and w['occupied']), default=0) + 1
    current = next((w['num'] for w in workspaces if w['focused']), -1)
    return {'workspaces': workspaces, 'last': last, 'current': current}


def workspace_target(current, step, last):
    if current < 1:
        return 1
    if current == 1 and step < 0:
        # Backward wrap skips the extra empty slot; forward navigation offers it.
        return max(1, last - 1)
    if current > last:
        return 1 if step > 0 else last
    return (current - 1 + step) % last + 1


def main():
    def stop(*_):
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, stop)
    # Keep watching Sway's workspace events; renaming does not move or focus windows.
    process = subprocess.Popen(['swaymsg', '-m', '-r', '-t', 'subscribe', '["workspace"]'],
                               stdout=subprocess.PIPE, text=True)
    try:
        if enabled():
            normalize()
        for line in process.stdout:
            event = json.loads(line)
            if event.get('change') in ('init', 'empty', 'rename') and enabled():
                normalize()
        raise RuntimeError('Sway workspace subscription ended')
    finally:
        process.terminate()
        process.wait(timeout=3)


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        logging.error('%s', error)
        raise SystemExit(1)
