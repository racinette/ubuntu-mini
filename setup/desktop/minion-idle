#!/usr/bin/python3
"""Keep idle lock/blank timers on battery and stay awake on external power."""
from pathlib import Path
import signal
import subprocess
import threading


def external_power(supplies=Path('/sys/class/power_supply')):
    for supply in supplies.glob('*'):
        try:
            if ((supply / 'type').read_text().strip() != 'Battery'
                    and (supply / 'online').read_text().strip() == '1'):
                scope = supply / 'scope'
                if not scope.exists() or scope.read_text().strip() != 'Device':
                    return True
        except OSError:
            continue
    return False


def idle_command(on_ac):
    command = ['/usr/bin/swayidle', '-w']
    if not on_ac:
        command += ['timeout', '300', 'minion-lock',
                    'timeout', '600', 'swaymsg output * power off',
                    'resume', 'swaymsg output * power on']
    # Explicit suspend still waits for the authenticated lock on either source.
    return command + ['before-sleep', 'minion-lock']


def stop_child(process):
    if process is None:
        return
    if process.poll() is None:
        process.terminate()
    try:
        process.wait(timeout=3)
    except subprocess.TimeoutExpired:
        process.kill()
        process.wait()


def supervise(stopping):
    process, current = None, None
    try:
        while not stopping.is_set():
            on_ac = external_power()
            if process is not None and process.poll() is not None:
                raise RuntimeError('swayidle exited unexpectedly')
            if on_ac != current:
                stop_child(process)
                process = None
                if on_ac:
                    subprocess.run(['swaymsg', 'output', '*', 'power', 'on'],
                                   check=True, timeout=5)
                print('External power: idle timers disabled.' if on_ac else
                      'Battery: lock after 5 minutes, displays off after 10.', flush=True)
                process = subprocess.Popen(idle_command(on_ac))
                current = on_ac
            stopping.wait(2)
    finally:
        stop_child(process)


def main():
    stopping = threading.Event()
    for sig in (signal.SIGTERM, signal.SIGINT):
        signal.signal(sig, lambda *_: stopping.set())
    supervise(stopping)


if __name__ == '__main__':
    main()
