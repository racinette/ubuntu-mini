[Unit]
Description=minion authenticated screen lock
PartOf=minion-session.target
After=graphical-session.target

[Service]
Type=forking
ExecStartPre=/usr/local/bin/minion-gamepad --pause
ExecStart=/usr/bin/swaylock --daemonize --color 151820
ExecStopPost=/usr/local/bin/minion-gamepad --resume
ExecStopPost=-/usr/bin/systemctl --user --no-block start minion-voice.service
