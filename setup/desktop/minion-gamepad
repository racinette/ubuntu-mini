def pipewire_midi_ports(snapshot, pid, direction):
    """Resolve MIDI ports through PipeWire's authenticated client PID."""
    objects = {entry['id']: entry for entry in snapshot}
    found = []
    for entry in snapshot:
        if entry.get('type') != 'PipeWire:Interface:Port':
            continue
        properties = entry.get('info', {}).get('props', {})
        if properties.get('port.direction') != direction or properties.get('format.dsp') != '8 bit raw midi':
            continue
        node = objects.get(int(properties.get('node.id', -1)), {}).get('info', {}).get('props', {})
        client = objects.get(int(node.get('client.id', -1)), {}).get('info', {}).get('props', {})
        owner = client.get('pipewire.sec.pid', client.get('application.process.id', -1))
        if int(owner) == pid:
            found.append((entry['id'], properties.get('port.name', '')))
    return found


class ReaperMidi:
    """Use the focused REAPER process's JACK or ALSA controller input."""
    def __init__(self):
        # Debian's RtMidi links libjack. Load PipeWire's implementation before
        # importing it so a controller cannot try to start a separate JACK server.
        jack_library = Path('/usr/lib/x86_64-linux-gnu/pipewire-0.3/jack/libjack.so.0')
        if jack_library.exists():
            ctypes.CDLL(str(jack_library), mode=ctypes.RTLD_GLOBAL)
        import rtmidi
        self.rtmidi = rtmidi
        self.output = rtmidi.MidiOut(rtmidi.API_LINUX_ALSA, name='Device gamepad')
        self.jack_output = None
        self.jack_route = None
        self.backend = None
        self.input_index = 0
        try:
            resource = Path(os.environ.get('XDG_CONFIG_HOME', Path.home() / '.config')) / 'REAPER'
            self.input_index = int(json.loads((resource / 'Data/device-gamepad.json').read_text())['mainUnit']['controlDeviceId'])
            if not 0 <= self.input_index < 62:
                raise ValueError('Invalid controller MIDI input index')
        except (OSError, KeyError, ValueError):
            self.input_index = 0
        self.alsa = ctypes.CDLL('libasound.so.2')
        pointer = ctypes.c_void_p
        signatures = {
            'snd_seq_open': [ctypes.POINTER(pointer), ctypes.c_char_p, ctypes.c_int, ctypes.c_int],
            'snd_seq_close': [pointer],
            'snd_seq_client_info_malloc': [ctypes.POINTER(pointer)],
            'snd_seq_client_info_free': [pointer],
            'snd_seq_get_any_client_info': [pointer, ctypes.c_int, pointer],
            'snd_seq_client_info_get_pid': [pointer],
        }
        for name, arguments in signatures.items():
            getattr(self.alsa, name).argtypes = arguments
        self.sequence, self.info = pointer(), pointer()
        if self.alsa.snd_seq_open(ctypes.byref(self.sequence), b'default', 1, 1) < 0:
            raise OSError('ALSA MIDI sequencer is unavailable')
        if self.alsa.snd_seq_client_info_malloc(ctypes.byref(self.info)) < 0:
            self.alsa.snd_seq_close(self.sequence)
            raise OSError('Cannot inspect ALSA MIDI clients')
        self.pid, self.connected_at = None, 0
        self.fine_value = None

    def disconnect_jack(self):
        if self.jack_route:
            try:
                subprocess.run(['pw-link', '-d', *map(str, self.jack_route)], check=False,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
            except (OSError, subprocess.TimeoutExpired):
                pass
            self.jack_route = None

    def close(self):
        for output in (self.output, self.jack_output):
            if output:
                if output.is_port_open():
                    output.send_message([0xBF, 31, 127])
                    output.send_message([0xBF, 31, 0])
                    output.send_message([0xBF, 22, 0])
                output.close_port()
                output.delete()
        self.disconnect_jack()
        self.alsa.snd_seq_client_info_free(self.info)
        self.alsa.snd_seq_close(self.sequence)

    @staticmethod
    def graph():
        return json.loads(subprocess.check_output(['pw-dump'], text=True, timeout=2))

    def connect_jack(self, pid, snapshot):
        targets = [port for port, name in pipewire_midi_ports(snapshot, pid, 'in')
                   if name == f'MIDI Input {self.input_index + 1}']
        if not targets:
            return False
        if len(targets) != 1:
            raise OSError('Several JACK controller inputs match this REAPER process')
        if self.jack_output is None:
            self.jack_output = self.rtmidi.MidiOut(self.rtmidi.API_UNIX_JACK, name='Device gamepad')
            self.jack_output.open_virtual_port('Controls')
        sources = []
        for attempt in range(5):
            sources = [port for port, name in pipewire_midi_ports(snapshot, os.getpid(), 'out') if name == 'Controls']
            if sources:
                break
            time.sleep(.02)
            snapshot = self.graph()
        if len(sources) != 1:
            raise OSError('JACK controller output is unavailable')
        route = (sources[0], targets[0])
        linked = any(entry.get('type') == 'PipeWire:Interface:Link'
                     and entry.get('info', {}).get('output-port-id') == route[0]
                     and entry.get('info', {}).get('input-port-id') == route[1]
                     for entry in snapshot)
        if route != self.jack_route or not linked:
            self.disconnect_jack()
            subprocess.run(['pw-link', *map(str, route)], check=True, timeout=2,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            self.jack_route = route
        self.backend = 'jack'
        return True

    def pulse(self, pid, control, value=127):
        now = time.monotonic()
        if pid != self.pid or now - self.connected_at > 2 or self.backend is None:
            try:
                snapshot = self.graph()
            except (OSError, ValueError, subprocess.SubprocessError):
                snapshot = []
            if not self.connect_jack(pid, snapshot):
                matches = []
                for index, name in enumerate(self.output.get_ports()):
                    if 'Virtual RawMIDI' not in name:
                        continue
                    address = name.rsplit(' ', 1)[-1].split(':')
                    if len(address) != 2 or not all(part.isdecimal() for part in address):
                        continue
                    if (self.alsa.snd_seq_get_any_client_info(self.sequence, int(address[0]), self.info) >= 0
                            and self.alsa.snd_seq_client_info_get_pid(self.info) == pid):
                        matches.append(index)
                if len(matches) != 1:
                    raise OSError('REAPER controller MIDI input is unavailable; enable its MIDI input')
                self.disconnect_jack()
                self.output.close_port()
                self.output.open_port(matches[0], 'Controls')
                self.backend = 'alsa'
            if pid != self.pid:
                self.fine_value = None
            self.pid, self.connected_at = pid, now
        output = self.jack_output if self.backend == 'jack' else self.output
        if control == 20:
            # Absolute 14-bit CC: send MSB and LSB together, including zero.
            # There is no button-release pulse for a retained knob position.
            output.send_message([0xBF, 20, value >> 7])
            output.send_message([0xBF, 52, value & 127])
            return
        if control == 22:
            if self.fine_value == value:
                return
            self.fine_value = value
        output.send_message([0xBF, control, value])
        if control not in (22,26):
            output.send_message([0xBF, control, 0])

# Xbox/xpad uses Linux's historical BTN_X=BTN_NORTH, BTN_Y=BTN_WEST
# aliases. The directional code names do not match Xbox button positions.
FACE_NAMES = {'A': 'BTN_SOUTH', 'B': 'BTN_EAST', 'X': 'BTN_NORTH', 'Y': 'BTN_WEST'}
DIRECTION_PAIRS = ({'UP', 'LEFT'}, {'UP', 'RIGHT'}, {'DOWN', 'LEFT'}, {'DOWN', 'RIGHT'})
FACE_PAIRS = ({'X', 'Y'}, {'Y', 'B'}, {'B', 'A'}, {'A', 'X'})


def chord_tokens(name):
    tokens = name.split('+')
    if 'SELECT' in tokens:
        if len(tokens) != 2 or len(set(tokens)) != 2 or not (set(tokens) - {'SELECT'}) <= set(FACE_NAMES):
            raise ValueError('Select shortcuts require exactly one face button: ' + name)
        return frozenset(tokens)
    directions = set(tokens) & {'UP', 'DOWN', 'LEFT', 'RIGHT'}
    faces = set(tokens) & set(FACE_NAMES)
    if (len(set(tokens)) != len(tokens) or set(tokens) != directions | faces
            or len(directions) > 2 or len(faces) > 2
            or len(directions) == 2 and directions not in DIRECTION_PAIRS
            or len(faces) == 2 and faces not in FACE_PAIRS
            or set(tokens) & {'X', 'Y'} or len(tokens) < 2):
        raise ValueError('Invalid shortcut chord: ' + name)
    return frozenset(tokens)


class ReleaseGesture:
    """Latch overlapping controls, then commit once all have been released."""
    def __init__(self):
        self.clear()

    def clear(self):
        self.previous = frozenset()
        self.peak = frozenset()
        self.releasing = False
        self.invalid = False

    def update(self, held):
        held = frozenset(held)
        if self.previous - held:
            self.releasing = True
        # A newly pressed control during release must not create a phantom chord.
        if self.releasing and held - self.previous:
            self.invalid = True
        if not self.releasing:
            self.peak = held
        self.previous = held
        if held:
            return None
        result = self.peak if not self.invalid else frozenset()
        self.clear()
        return result or None


def runtime():
    path = Path(os.environ['XDG_RUNTIME_DIR']) / 'minion-gamepad'
    path.mkdir(mode=0o700, exist_ok=True)
    if path.is_symlink() or path.stat().st_uid != os.getuid():
        raise ValueError('Gamepad runtime directory must belong to the session user')
    path.chmod(0o700)
    return path


def ipc(message, message_type=0):
    with socket.socket(socket.AF_UNIX) as sock:
        sock.settimeout(2)
        sock.connect(os.environ['SWAYSOCK'])
        data = message.encode()
        sock.sendall(b'i3-ipc' + struct.pack('<II', len(data), message_type) + data)

        def receive(size):
            data = b''
            while len(data) < size:
                chunk = sock.recv(size - len(data))
                if not chunk:
                    raise EOFError('Sway disconnected')
                data += chunk
            return data

        header = receive(14)
        if header[:6] != b'i3-ipc':
            raise ValueError('Unexpected Sway response')
        length, _ = struct.unpack('<II', header[6:])
        return json.loads(receive(length))


class Session:
    """libsystemd reads logind session state without spawning periodic processes."""
    def __init__(self):
        self.lib = ctypes.CDLL('libsystemd.so.0')
        self.lib.sd_uid_get_display.argtypes = [ctypes.c_uint, ctypes.POINTER(ctypes.c_void_p)]
        self.lib.sd_session_is_active.argtypes = [ctypes.c_void_p]
        self.free = ctypes.CDLL(None).free
        self.free.argtypes = [ctypes.c_void_p]

    def active(self):
        pointer = ctypes.c_void_p()
        if self.lib.sd_uid_get_display(os.getuid(), ctypes.byref(pointer)) < 0:
            return False
        try:
            return self.lib.sd_session_is_active(pointer) > 0
        finally:
            self.free(pointer)


def configuration(path, codes):
    config = json.loads(Path('/etc/minion/gamepad.json').read_text())
    override = Path(path) if path else Path.home() / '.config/minion/gamepad.json'
    if override.exists():
        changes = json.loads(override.read_text())
        if not isinstance(changes, dict) or set(changes) - set(config):
            raise ValueError('Unknown gamepad profile setting')
        config.update(changes)
    profiles = config.pop('profiles', {})
    if not isinstance(profiles, dict) or set(profiles) != {'reaper'}:
        raise ValueError('profiles requires the reaper mapping')
    changes = profiles['reaper']
    if not isinstance(changes, dict) or set(changes) - {'buttons', 'actions', 'hold_actions', 'chords', 'scroll_rate', 'zoom_rate'}:
        raise ValueError('REAPER profile supports buttons, actions, hold_actions, chords and stick rates')
    reaper = compile_configuration(dict(config, **changes), codes, reaper=True)
    result = compile_configuration(dict(config), codes)
    result['profiles'] = {'reaper': reaper}
    return result


def compile_configuration(config, codes, reaper=False):
    for prefix in ('stick', 'trigger'):
        if not 0 <= config[prefix + '_release'] < config[prefix + '_press'] <= 1:
            raise ValueError('Invalid ' + prefix + ' thresholds')
    for name in ('repeat_delay', 'repeat_interval', 'action_hold',
                 'dpad_repeat_delay', 'dpad_acceleration_time'):
        if not .05 <= config[name] <= 10:
            raise ValueError('Invalid ' + name)
    for name in ('selection_rate', 'selection_line_rate', 'scroll_rate', 'zoom_rate',
                 'dpad_rate', 'dpad_line_rate'):
        rates = config[name]
        if (not isinstance(rates, list) or len(rates) != 2
                or any(type(rate) is not int for rate in rates)
                or not 1 <= rates[0] <= rates[1] <= 100):
            raise ValueError('Invalid ' + name)
    if not isinstance(config['resize_step'], int) or not 1 <= config['resize_step'] <= 25:
        raise ValueError('Invalid resize_step')
    numbers = config['workspace_numbers']
    if numbers is not None and (not isinstance(numbers, list) or not numbers
            or any(type(n) is not int or not 1 <= n <= 1000 for n in numbers)
            or len(set(numbers)) != len(numbers)):
        raise ValueError('workspace_numbers must be null or a list of unique positive numbers')
    if not isinstance(config['device'], dict) or set(config['device']) - {'name', 'vendor', 'product'}:
        raise ValueError('device supports name, vendor and product selectors')
    modes = config['mode_directions']
    if (not isinstance(modes, dict) or not set(modes) <= {'LEFT', 'RIGHT', 'UP', 'DOWN'}
            or len(modes) != len(MODES) or set(modes.values()) != set(MODES)):
        raise ValueError('mode_directions requires one direction per gamepad mode')
    for name in ('left_stick', 'right_stick'):
        if len(config[name]) != 2:
            raise ValueError(name + ' requires two axes')

    def code(name, prefix):
        if not isinstance(name, str) or not name.startswith(prefix) or name not in codes.ecodes:
            raise ValueError('Unknown input symbol: ' + str(name))
        return codes.ecodes[name]

    config['buttons'] = {code(k, 'BTN_'): code(v, 'KEY_') for k, v in config['buttons'].items()}
    config['actions'] = {code(k, 'BTN_'): v for k, v in config['actions'].items()}
    config['hold_actions'] = {code(k, 'BTN_'): v for k, v in config['hold_actions'].items()}
    if any(v not in ACTION_LABELS for v in (*config['actions'].values(), *config['hold_actions'].values())):
        raise ValueError('Unknown desktop button action')
    if not set(config['hold_actions']) <= set(config['actions']):
        raise ValueError('Hold actions require a matching short-press action')
    config['dpad'] = {code(k, 'ABS_'): [code(v, 'KEY_') for v in values] for k, values in config['dpad'].items()}
    if any(len(values) != 2 for values in config['dpad'].values()):
        raise ValueError('Each D-pad axis needs negative and positive keys')
    for name in ('left_stick', 'right_stick'):
        config[name] = [code(v, 'ABS_') for v in config[name]]
    for name in ('shift_trigger', 'ctrl_trigger'):
        config[name] = code(config[name], 'ABS_')
    for name in ('previous_bumper', 'next_bumper'):
        config[name] = code(config[name], 'BTN_')
    config['chord_axes'] = [code(v, 'ABS_') for v in config['chord_axes']]
    if len(config['chord_axes']) != 2 or len(set(config['chord_axes'])) != 2 or not set(config['chord_axes']) <= set(config['dpad']):
        raise ValueError('chord_axes requires the horizontal and vertical D-pad axes')
    chords = {}
    for name, action in config['chords'].items():
        tokens = chord_tokens(name)
        if tokens in chords:
            raise ValueError('Duplicate shortcut chord: ' + name)
        if not isinstance(action, str) or action not in ACTION_LABELS:
            raise ValueError('Unknown shortcut action: ' + str(action))
        chords[tokens] = action
    config['chords'] = chords
    config['chord_faces'] = {name: code(symbol, 'BTN_') for name, symbol in FACE_NAMES.items() if name in ('A', 'B')}
    if not set(config['chord_faces'].values()) <= set(config['buttons']):
        raise ValueError('Shortcuts require A and B in buttons')
    if not reaper and config['buttons'].get(code(FACE_NAMES['X'], 'BTN_')) != code('KEY_BACKSPACE', 'KEY_'):
        raise ValueError('X is reserved for holdable Backspace')
    if not reaper and config['buttons'].get(code(FACE_NAMES['Y'], 'BTN_')) != code('KEY_SPACE', 'KEY_'):
        raise ValueError('Y is reserved for holdable Space')
    if reaper and config['actions'].get(code(FACE_NAMES['Y'], 'BTN_')) != 'reaper_play_stop':
        raise ValueError('REAPER Y must be the discrete play/stop action')
    action_keys = set(config['actions'])
    bumpers = {config['previous_bumper'], config['next_bumper']}
    if action_keys & set(config['buttons']) or bumpers & (action_keys | set(config['buttons'])):
        raise ValueError('A button may have only one individual action')
    if len(bumpers) != 2:
        raise ValueError('Bumpers must be distinct')
    if code('BTN_SELECT', 'BTN_') in config['hold_actions']:
        raise ValueError('Select is reserved for release shortcuts')
    return config


class Mapper:
    def __init__(self, config, keyboard, codes, directory):
        self.desktop_config = config
        self.keyboard, self.e, self.directory = keyboard, codes, directory
        mode_path = directory / 'mode'
        self.mode = mode_path.read_text().strip() if mode_path.exists() else 'desktop'
        if self.mode not in MODES:
            self.mode = 'desktop'
        self.device = None
        self.grabbed = False
        self.keys = set()
        self.legend = None
        self.launcher = None
        self.picker = None
        self.stick_modes, self.stick_pending = self.default_sticks(), [None, None]
        self.publish_stick_mode()
        self.raw_keys = set()
        self.raw_axes = {}
        self.ranges = {}
        self.triggers = [False, False]
        self.sticks = [None, None]
        self.next_repeat = [0, 0]
        self.motion_time, self.motion_credit = [None, None], [0, 0]
        self.ready = False
        self.lid_blocked = False
        self.running = True
        self.mode_gesture = ReleaseGesture()
        self.mode_since = None
        self.pending_buttons = set()
        self.button_since = {}
        self.text_gesture = ReleaseGesture()
        self.select_gesture = ReleaseGesture()
        self.select_in_legend = False
        self.clear_dpad_navigation()
        self.gesture_in_legend = False
        self.unavailable_actions = []
        self.actions = deque(maxlen=24)
        self.reason = 'Waiting for a controller'
        self.reaper_midi = None
        self.reaper_error_at = 0
        self.reaper_area_held = self.reaper_area_cancelled = False
        self.rotary_target, self.rotary_ready = '', False
        self.rotary_value, self.rotary_time = None, float('-inf')
        self.transport_target,self.transport_ready='',False
        self.dialog_active,self.dialog_ready=False,False
        self.dialog_buttons=set()
        self.dialog_direction,self.dialog_next=None,0

    @property
    def config(self):
        return self.desktop_config['profiles']['reaper'] if self.mode == 'reaper' else self.desktop_config

    def stick_choices(self, index):
        return ('zoom', 'windows') if self.mode == 'reaper' and index == 1 else STICK_MODES[index]

    def default_sticks(self):
        return [self.stick_choices(index)[0] for index in range(2)]

    def write_keys(self, desired):
        desired = set(desired)
        modifiers = {self.e.KEY_LEFTSHIFT, self.e.KEY_LEFTCTRL, self.e.KEY_LEFTMETA, self.e.KEY_LEFTALT}
        for key in sorted(self.keys - desired, key=lambda k: (k in modifiers, k)):
            self.keyboard.write(self.e.EV_KEY, key, 0)
        for key in sorted(desired - self.keys, key=lambda k: (k not in modifiers, k)):
            self.keyboard.write(self.e.EV_KEY, key, 1)
        if self.keys != desired:
            self.keyboard.syn()
        self.keys = set(desired)

    def reset(self):
        self.reaper_area_held = self.reaper_area_cancelled = False
        self.rotary_target, self.rotary_ready = '', False
        self.rotary_value, self.rotary_time = None, float('-inf')
        self.transport_target,self.transport_ready='',False
        self.dialog_active,self.dialog_ready=False,False
        self.dialog_buttons=set()
        self.dialog_direction,self.dialog_next=None,0
        if self.reaper_midi:
            self.reaper_midi.close()
            self.reaper_midi = None
        self.write_keys(set())
        self.close_legend()
        self.close_overlay('launcher')
        self.close_overlay('picker')
        self.stick_modes, self.stick_pending = self.default_sticks(), [None, None]
        self.publish_stick_mode()
        self.triggers = [False, False]
        self.sticks = [None, None]
        self.next_repeat = [0, 0]
        self.motion_time, self.motion_credit = [None, None], [0, 0]
        self.ready = False
        self.lid_blocked = False
        self.pending_buttons.clear()
        self.button_since.clear()
        self.text_gesture.clear()
        self.select_gesture.clear()
        self.select_in_legend = False
        self.clear_dpad_navigation()
        self.gesture_in_legend = False
        self.mode_gesture.clear()
        self.mode_since = None

    def publish_stick_mode(self):
        label = f'L:{self.stick_modes[0].capitalize()} R:{self.stick_modes[1].capitalize()}'
        if self.mode == 'reaper':
            label = 'REAPER controls'
        elif self.mode == 'passthrough':
            label = 'Gamepad'
        (self.directory / 'stick-mode').write_text(label + '\n')

    def close_overlay(self, name):
        process = getattr(self, name)
        if process:
            if process.poll() is None:
                process.terminate()
                try:
                    process.wait(timeout=1)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait(timeout=1)
            setattr(self, name, None)

    def close_legend(self):
        self.close_overlay('legend')

    def toggle_picker(self):
        if self.picker and self.picker.poll() is None:
            self.close_overlay('picker')
        else:
            self.close_overlay('launcher')
            try:
                self.picker = subprocess.Popen(['minion-window-picker'])
            except OSError as error:
                self.notify('Cannot show window picker: ' + str(error))

    def toggle_launcher(self):
        self.close_overlay('picker')
        if self.legend_open():
            self.close_legend()
        elif self.launcher and self.launcher.poll() is None:
            self.close_overlay('launcher')
        else:
            try:
                self.launcher = subprocess.Popen(['fuzzel', '--layer=overlay'], stdout=subprocess.DEVNULL)
            except OSError as error:
                self.notify('Cannot show application launcher: ' + str(error))

    def legend_open(self):
        if self.legend and self.legend.poll() is not None:
            self.legend = None
        return self.legend is not None

