#!/usr/bin/python3
"""Open a project in the separate, read-only Neovim browsing profile."""
import argparse
import os
from pathlib import Path


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('path', nargs='?', help='Project directory or file (defaults to current directory)')
    parser.add_argument('--home', action='store_true', help='Browse home from the application launcher')
    args = parser.parse_args()
    home = Path.home()
    path = Path(args.path or (home if args.home else Path.cwd())).expanduser().resolve()
    if not path.exists():
        parser.error(f'Path does not exist: {path}')
    env = dict(os.environ, NVIM_APPNAME='minion-view')
    # Launchers do not source interactive Bash or activate mise.
    env['PATH'] = f'{home}/.local/bin:{home}/.local/share/mise/shims:{home}/.cargo/bin:' + env.get('PATH', '/usr/bin:/bin')
    os.chdir(path if path.is_dir() else path.parent)
    os.execvpe('nvim', ['nvim', '-R', *(['--', str(path)] if path.is_file() else [])], env)


if __name__ == '__main__':
    main()
