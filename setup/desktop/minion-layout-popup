#!/usr/bin/python3
"""Show a transient popup when the active physical keyboard layout changes."""
import html
import json
import logging
import signal
import subprocess

KEYBOARD = '1:1:AT_Translated_Set_2_keyboard'
CODES = {'English (US)': 'US', 'English (UK)': 'UK', 'Russian': 'RU',
         'German': 'DE', 'French': 'FR', 'Spanish': 'ES', 'Ukrainian': 'UA'}


def selected_layout(inputs):
    keyboards = [item for item in inputs if isinstance(item, dict) and item.get('type') == 'keyboard'
                 and item.get('name') != 'Minion gamepad keyboard']
    primary = next((item for item in keyboards if item.get('identifier') == KEYBOARD), None)
    if primary is None:
        physical = [item for item in keyboards if item.get('vendor')
                    and len(item.get('xkb_layout_names') or []) > 1]
        primary = next(iter(sorted(physical, key=lambda item: item.get('identifier', ''))), None)
    if primary is None or len(primary.get('xkb_layout_names') or []) < 2:
        return None
    name = primary.get('xkb_active_layout_name')
    return name if isinstance(name, str) and name else None


class Popup:
    def __init__(self, inputs):
        self.layout = selected_layout(inputs)
        self.notification_id = 0

    def update(self, inputs):
        layout = selected_layout(inputs)
        previous, self.layout = self.layout, layout
        if layout is None or previous is None or layout == previous:
            return
        label = CODES.get(layout, layout[:12])
        try:
            result = subprocess.run(
                ['notify-send', '-a', 'minion-layout', '-p', '-r', str(self.notification_id),
                 '-e', '-u', 'low', '-t', '1000', '--', html.escape(label), html.escape(layout[:80])],
                capture_output=True, text=True, check=True, timeout=3)
            if result.stdout.strip().isdecimal():
                self.notification_id = int(result.stdout.strip())
        except (OSError, subprocess.SubprocessError):
            logging.warning('Could not display the keyboard layout popup')


def inputs():
    data = json.loads(subprocess.check_output(['swaymsg', '-r', '-t', 'get_inputs'], text=True, timeout=3))
    if not isinstance(data, list):
        raise ValueError('Sway returned an invalid keyboard list')
    return data


def main():
    def stop(*_):
        raise SystemExit(0)
    signal.signal(signal.SIGTERM, stop)
    process = subprocess.Popen(['swaymsg', '-m', '-r', '-t', 'subscribe', '["input"]'],
                               stdout=subprocess.PIPE, text=True)
    try:
        # swaymsg monitor mode may omit the subscription acknowledgement.
        # Accept either stream shape; only input-change events trigger output.
        popup = Popup(inputs())
        for line in process.stdout:
            event = json.loads(line)
            if event.get('change') in ('xkb_layout', 'xkb_keymap', 'added', 'removed'):
                # Refresh the current snapshot rather than replaying stale events
                # from shared-keymap changes or device hotplug.
                popup.update(inputs())
        raise RuntimeError('Sway keyboard subscription ended')
    finally:
        process.terminate()
        try:
            process.wait(timeout=3)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        logging.error('%s', error)
        raise SystemExit(1)
