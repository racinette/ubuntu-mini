    def toggle_legend(self):
        if self.legend_open():
            self.close_legend()
            return
        self.close_overlay('launcher')
        self.close_overlay('picker')
        self.text_gesture.clear()
        try:
            self.legend = subprocess.Popen(
                ['fuzzel', '--dmenu', '--layer=overlay', '--width=64', '--lines=18', '--prompt=Controls > '],
                stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, text=True)
            self.legend.stdin.write(self.legend_text())
            self.legend.stdin.close()
        except (OSError, BrokenPipeError) as error:
            self.close_legend()
            self.notify('Cannot show shortcut legend: ' + str(error))

    def notify(self, label):
        log.info(label)
        try:
            subprocess.run(['notify-send', '-a', 'minion', '-t', '2500',
                            'Gamepad controls', label], check=False, timeout=2)
        except (OSError, subprocess.TimeoutExpired) as error:
            log.warning('Gamepad notification failed: %s', error)

    def reaper_control(self, control, value=None, *, cleanup=False):
        if control in (*range(8), 12, 18, 19, 23, 24, 25, 26, 31, 40, 48, 49):
            # Gate immediately on controller navigation, before the display's
            # next context publication, so a held angle cannot hit a new knob.
            self.rotary_ready = False
        if cleanup:
            if self.reaper_midi and self.reaper_midi.pid is not None:
                try:
                    self.reaper_midi.pulse(self.reaper_midi.pid,control)
                except (OSError,RuntimeError,ValueError,subprocess.SubprocessError) as error:
                    log.warning('Cannot cancel REAPER area selection: %s',error)
            return
        if not self.focused_reaper():
            return
        try:
            node = self.focused_window()
            if self.reaper_midi is None:
                self.reaper_midi = ReaperMidi()
            fine = 127 if any(self.triggers) else 0
            self.reaper_midi.pulse(node['pid'], 22, fine)
            if control != 22:
                if value is None:
                    self.reaper_midi.pulse(node['pid'], control)
                else:
                    self.reaper_midi.pulse(node['pid'], control, value)
                    if control==20 and self.transport_target=='60004':
                        self.reaper_midi.pulse(node['pid'],50)
        except (ImportError, OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
            if time.monotonic() - self.reaper_error_at > 5:
                self.reaper_error_at = time.monotonic()
                self.notify('REAPER controls unavailable: ' + str(error))

    def focused_window(self):
        def focused(node):
            children = node.get('nodes', []) + node.get('floating_nodes', [])
            if node.get('focused') and not children and node.get('pid'):
                return node
            for child in children:
                result = focused(child)
                if result:
                    return result

        node = focused(ipc('', 4))
        if not node:
            raise ValueError('No focused application')
        return node

    def focused_application(self):
        """Check both Wayland/X11 identifiers and the actual compositor client."""
        node = self.focused_window()
        pid = node['pid']
        if type(pid) is not int or pid <= 0:
            raise ValueError('Invalid focused application PID')
        executable = Path(os.readlink(f'/proc/{pid}/exe').removesuffix(' (deleted)')).name.lower()
        properties = node.get('window_properties') or {}
        names = {executable, (node.get('app_id') or '').lower(),
                 (properties.get('class') or '').lower(), (properties.get('instance') or '').lower()}
        foot = executable in ('foot', 'footclient')
        terminal = foot or any('term' in name or name in {
            'kitty', 'alacritty', 'konsole', 'st', 'urxvt', 'rxvt', 'contour',
            'ghostty', 'rio', 'blackbox', 'guake', 'tilda', 'yakuake',
            'kgx', 'ptyxis', 'tilix', 'warp', 'hyper', 'tabby',
        } for name in names)
        return 'reaper' if executable == 'reaper' and 'reaper' in names else 'foot' if foot else 'terminal' if terminal else 'gui'

    def reaper_window_kind(self):
        """Separate native modal dialogs from project/FX control surfaces."""
        if self.legend_open() or any(process and process.poll() is None
                                    for process in (self.launcher, self.picker)):
            return None
        try:
            node = self.focused_window()
            if Path(os.readlink(f'/proc/{node["pid"]}/exe').removesuffix(' (deleted)')).name != 'reaper':
                return None
            properties = node.get('window_properties') or {}
            names = {(node.get('app_id') or '').lower(), (properties.get('class') or '').lower()}
            title = node.get('name') or ''
            fx = title.startswith(('FX:', 'VST:', 'VSTi:', 'VST3:', 'JS:'))
            settings = title == 'FX: Monitoring' or 'Helgobox' in title
            if (properties.get('window_type') == 'dialog' or properties.get('transient_for')) and (not fx or settings):
                return 'dialog'
            if 'reaper' not in names or settings:
                return None
            if title == 'REAPER gamepad controls':
                return 'controls'
            if fx:
                return 'fx'
            if 'REAPER v' in title and not title.startswith('About REAPER'):
                return 'project'
        except (OSError, ValueError, EOFError, KeyError):
            pass
        return None

    def focused_reaper(self):
        return self.reaper_window_kind() in ('project','controls','fx')

    def focused_reaper_menu(self):
        try:
            if not any(time.time()-path.stat().st_mtime<=.5 for path in self.directory.glob('reaper-outline-*.native-menu')):
                return False
            node=self.focused_window()
            pid=node['pid']
            marker=self.directory/f'reaper-outline-{pid}.native-menu'
            if time.time()-marker.stat().st_mtime>.5 or marker.read_text().strip()!=str(pid):
                return False
            return self.reaper_window_kind() in ('project','fx','controls')
        except (OSError,ValueError,EOFError,KeyError):
            return False

    def focused_reaper_dialog(self):
        return self.reaper_window_kind() == 'dialog'

    def shortcut(self, key, modifiers):
        if (self.mode == 'reaper' and key in (self.e.KEY_ENTER, self.e.KEY_ESC)
                and self.focused_reaper()):
            self.reaper_control(18 if key == self.e.KEY_ENTER else 19)
            return
        self.keyboard_shortcut(key,modifiers)

    def keyboard_shortcut(self,key,modifiers):
        held = set(self.keys)
        nonmodifiers = held - {self.e.KEY_LEFTSHIFT, self.e.KEY_LEFTCTRL, self.e.KEY_LEFTMETA, self.e.KEY_LEFTALT}
        base = nonmodifiers | set(modifiers)
        self.write_keys(base)
        self.write_keys(base | {key})
        self.write_keys(base)
        self.write_keys(held)

    def dispatch(self, action):
        if action in REAPER_CONTROLS:
            self.reaper_control(REAPER_CONTROLS[action])
        elif action == 'legend':
            self.toggle_legend()
        elif action == 'launcher':
            self.toggle_launcher()
        elif action == 'window_picker':
            self.toggle_picker()
        elif action in ('left_stick_context', 'right_stick_context',
                        'stick_context', 'text_navigation', 'selection'):
            indices = (0,) if action == 'left_stick_context' else (1,) if action == 'right_stick_context' else (0, 1)
            for index in indices:
                primary, secondary = self.stick_choices(index)
                current = self.stick_pending[index] or self.stick_modes[index]
                target = secondary if current == primary else primary
                self.stick_pending[index] = target if target != self.stick_modes[index] else None
                mode = self.stick_pending[index] or self.stick_modes[index]
                label = 'Left' if index == 0 else 'Right'
                self.notify(f'{label} stick: {mode.capitalize()}' +
                            (f' — center the {label.lower()} stick' if self.stick_pending[index] else ''))
        elif action == 'equalize':
            self.equalize()
        elif action in ACTION_COMMANDS:
            self.command(ACTION_COMMANDS[action])
        else:
            key, names = KEY_ACTIONS[action]
            modifiers = {getattr(self.e, name) for name in names}
            if action in NAVIGATION_ACTIONS:
                modifiers |= self.keys & {self.e.KEY_LEFTSHIFT, self.e.KEY_LEFTCTRL}
            elif action not in HISTORY_ACTIONS:
                try:
                    application = self.focused_application()
                except (OSError, ValueError, EOFError, KeyError) as error:
                    log.warning('Cannot identify focused application: %s', error)
                    self.notify('Shortcut skipped: cannot identify the focused application')
                    return
                if action in TERMINAL_ACTIONS:
                    if application not in ('foot', 'terminal'):
                        self.notify('This shortcut is only available in terminals')
                        return
                elif application in ('foot', 'terminal'):
                    if application == 'foot' and action in ('copy', 'paste'):
                        modifiers.add(self.e.KEY_LEFTSHIFT)
                    else:
                        self.notify('This shortcut is unavailable in terminals')
                        return
            self.shortcut(getattr(self.e, key), modifiers)

    def equalize(self):
        """Balance sibling tiles recursively without changing layout or focus."""
        def find(node, identity):
            if node['id'] == identity:
                return node
            for child in node.get('nodes', []):
                result = find(child, identity)
                if result:
                    return result
        def focused(node):
            return node.get('focused') or any(focused(c) for c in node.get('nodes', []) + node.get('floating_nodes', []))
        def workspace(node):
            if node.get('type') == 'workspace' and focused(node):
                return node
            for child in node.get('nodes', []):
                result = workspace(child)
                if result:
                    return result
        def groups(node):
            children = node.get('nodes', [])
            result = [node['id']] if len(children) > 1 and node.get('layout') in ('splith', 'splitv') else []
            for child in children:
                result.extend(groups(child))
            return result
        try:
            target = workspace(ipc('', 4))
            if not target:
                return
            for identity in groups(target):
                # Each resize redistributes over siblings. Re-read and converge;
                # application minimum sizes can prevent an exact balance.
                for _ in range(12):
                    node = find(ipc('', 4), identity)
                    if not node or len(node.get('nodes', [])) < 2:
                        break
                    dimension = 'width' if node['layout'] == 'splith' else 'height'
                    children = node['nodes']
                    size = sum(c['rect'][dimension] for c in children) // len(children)
                    off = [c for c in children if abs(c['rect'][dimension] - size) > 2]
                    if not off:
                        break
                    child = max(off, key=lambda c: abs(c['rect'][dimension] - size))
                    if not self.command(f"[con_id={child['id']}] resize set {dimension} {size} px"):
                        break
                else:
                    self.notify('Some tiles could not be equalized within their size limits')
        except (OSError, ValueError, EOFError, KeyError) as error:
            log.warning('Cannot equalize workspace: %s', error)
            self.notify('Cannot equalize this workspace')

    def ungrab(self):
        self.reset()
        if self.grabbed:
            try:
                self.device.ungrab()
            except OSError:
                pass
        self.grabbed = False

    def detach(self):
        self.ungrab()
        if self.device:
            self.device.close()
        self.device = None
        self.raw_keys.clear()
        self.raw_axes.clear()

    def attach(self, device):
        self.device = device
        self.ranges = {code: (info.min, info.max) for code, info in device.capabilities(absinfo=True).get(self.e.EV_ABS, [])}
        available = set(device.capabilities(absinfo=False).get(self.e.EV_KEY, []))
        self.unavailable_actions = [action for code, action in self.config['actions'].items() if code not in available]
        self.resync()
        log.info('Controller found: %s (%s)', device.name, device.path)

    def resync(self):
        self.reset()
        self.raw_keys = set(self.device.active_keys())
        self.raw_axes = {code: self.device.absinfo(code).value for code in self.ranges}

    def axis(self, code, trigger=False):
        low, high = self.ranges[code]
        fraction = (self.raw_axes.get(code, low) - low) / (high - low)
        return max(0, min(1, fraction)) if trigger else max(-1, min(1, fraction * 2 - 1))

    def neutral(self):
        return (not self.raw_keys and all(abs(self.axis(code)) < self.config['stick_release'] for code in
                self.config['left_stick'] + self.config['right_stick'])
                and all(self.axis(self.config[name], True) < self.config['trigger_release']
                        for name in ('shift_trigger', 'ctrl_trigger'))
                and all(not self.raw_axes.get(code, 0) for code in self.config['dpad']))

    def toggle(self):
        self.set_mode(MODES[(MODES.index(self.mode) + 1) % len(MODES)])

    def set_mode(self, mode):
        self.ungrab()
        self.mode = mode
        self.reset()
        (self.directory / 'mode').write_text(self.mode + '\n')
        log.info('Gamepad mode: %s', self.mode)
        label = {'desktop': 'Desktop navigation enabled', 'reaper': 'REAPER editing controls enabled',
                 'passthrough': 'Normal gamepad input enabled'}[self.mode]
        self.notify(label)

    def command(self, command):
        try:
            result = ipc(command)
            passed = all(item.get('success') for item in result)
            self.actions.append({'command': command, 'success': passed})
            if not passed:
                log.warning('Sway refused %s: %s', command, result)
            return passed
        except (OSError, ValueError, EOFError) as error:
            log.warning('Sway command failed: %s', error)
            return False

    def workspace(self, step):
        numbers = self.config['workspace_numbers']
        if numbers is None:
            state = workspace_policy['workspace_state'](ipc('', 4))
            target = workspace_policy['workspace_target'](state['current'], step, state['last'])
        else:
            current = next(w for w in ipc('', 1) if w['focused'])['num']
            target = numbers[(numbers.index(current) + step) % len(numbers)] if current in numbers else numbers[0 if step > 0 else -1]
        command = 'move container to workspace number' if self.triggers[0] else 'workspace number'
        self.command(f'{command} {target}')

    def lid_closed(self):
        return (self.directory.parent / 'minion-idle/lid-closed').exists()

    def block_lid_input(self, active):
        if not self.lid_closed():
            if self.lid_blocked:
                # Wait for neutral before accepting controls held during reopen.
                self.reset()
            return False
        if not self.lid_blocked:
            self.reset()
            self.lid_blocked = True
        if not active:
            if self.grabbed or self.keys:
                self.ungrab()
                self.lid_blocked = True
        elif not self.grabbed and self.device:
            try:
                # Keep consuming the physical controller even in passthrough;
                # simply ungrabbing would deliver its input to other clients.
                self.device.grab()
                self.grabbed = True
            except OSError:
                pass
        return True

    def permitted(self, active):
        return active and not self.lid_closed() and not (self.directory / 'paused').exists() and self.mode in ('desktop', 'reaper')

    def button_gestures(self, pressed, released, now, active):
        """Defer discrete buttons to release; Start owns the mode gesture."""
        if not self.permitted(active) or not self.grabbed or not self.ready:
            self.pending_buttons.clear()
            self.button_since.clear()
            return
        reserved = set(self.config['chord_faces'].values()) | {self.e.BTN_NORTH, self.e.BTN_WEST}
        reserved -= set(self.config['actions'])
        reserved.add(self.e.BTN_START)
        eligible = pressed - reserved
        if self.select_gesture.previous or self.e.BTN_SELECT in self.raw_keys:
            faces = {getattr(self.e, symbol) for symbol in FACE_NAMES.values()}
            eligible -= faces
            self.pending_buttons.difference_update(faces)
        self.pending_buttons.update(eligible)
        for button in eligible:
            self.button_since[button] = now
        for button in sorted(set(self.config['hold_actions']) & self.pending_buttons):
            if now - self.button_since.get(button, now) >= self.config['action_hold']:
                self.pending_buttons.discard(button)
                action = self.config['hold_actions'][button]
                if not self.legend_open() or action == 'legend':
                    self.dispatch(action)
        for button in sorted(released & self.pending_buttons):
            if button == self.e.BTN_SELECT:
                continue  # Select alone and Select+face are handled together.
            if self.legend_open() and self.config['actions'].get(button) not in (
                    'legend', 'launcher', 'left_stick_context', 'right_stick_context',
                    'stick_context', 'text_navigation', 'selection'):
                continue
            if button in (self.config['previous_bumper'],self.config['next_bumper']):
                step = -1 if button == self.config['previous_bumper'] else 1
                if self.mode == 'reaper' and self.focused_reaper():
                    self.reaper_control(48 if step < 0 else 49)
                else:
                    self.workspace(step)
            elif button in self.config['actions']:
                self.dispatch(self.config['actions'][button])
        self.pending_buttons.difference_update(released)
        for button in released:
            self.button_since.pop(button, None)

    def mode_shortcut_frame(self, now, active):
        """Start first, then one direction; commit after both are released."""
        gesture = self.mode_gesture
        if not active or self.lid_closed() or (self.directory / 'paused').exists():
            gesture.clear()
            self.mode_since = None
            return False
        if self.mode == 'passthrough' and not self.ready:
            self.ready = self.neutral()
        if not self.ready or self.mode != 'passthrough' and not self.grabbed:
            return False
        if self.e.BTN_START not in self.raw_keys and not gesture.previous:
            return False
        held = {'START'} if self.e.BTN_START in self.raw_keys else set()
        horizontal, vertical = self.config['chord_axes']
        for axis, negative, positive in ((horizontal, 'LEFT', 'RIGHT'), (vertical, 'UP', 'DOWN')):
            value = self.raw_axes.get(axis, 0)
            if value:
                held.add(negative if value < 0 else positive)
        if self.raw_keys - {self.e.BTN_START}:
            held.add('OTHER')
        if not gesture.previous:
            self.mode_since = now
            if (held != {'START'} or self.text_gesture.previous or self.select_gesture.previous
                    or self.dpad_navigation or self.pending_buttons):
                gesture.invalid = True
        if len(held - {'START'}) > 1 or 'OTHER' in held:
            gesture.invalid = True
        if self.reaper_area_held:
            self.reaper_control(31,cleanup=True)
            self.reaper_area_held = False
        # Clear pending desktop/DAW gestures before any normal input can fire.
        self.pending_buttons.clear()
        self.button_since.clear()
        self.text_gesture.clear()
        self.select_gesture.clear()
        self.clear_dpad_navigation()
        self.write_keys(set())
        since = self.mode_since
        result = gesture.update(held)
        if not held:
            self.mode_since = None
        if result == {'START'} and self.mode != 'passthrough' and not self.legend_open():
            action = self.config['actions'].get(self.e.BTN_START)
            if now - since >= self.config['action_hold']:
                action = self.config['hold_actions'].get(self.e.BTN_START, action)
            if action:
                self.dispatch(action)
        elif result and 'START' in result and len(result) == 2:
            target = self.config['mode_directions'].get(next(iter(result - {'START'})))
            if target:
                self.set_mode(target)
        return True

    def reaper_area_frame(self, pressed, previous_triggers, now):
        """L2 borrows navigation until release; losing focus cancels it."""
        if self.mode != 'reaper':
            return False
        focused = self.focused_reaper() if self.triggers[0] or self.reaper_area_held else False
        if self.triggers[0] and not previous_triggers[0] and focused:
            self.reaper_area_held, self.reaper_area_cancelled = True, False
            self.pending_buttons.clear()
            self.button_since.clear()
            self.text_gesture.clear()
            self.select_gesture.clear()
            self.clear_dpad_navigation()
            self.rotary_ready = False
            self.sticks, self.next_repeat = [None,None],[0,0]
            self.motion_time, self.motion_credit = [None,None],[0,0]
            self.reaper_control(26,127)
        if not self.reaper_area_held:
            return False
        self.write_keys(set())
        if not focused or not self.triggers[0]:
            if not focused or self.reaper_area_cancelled:
                self.reaper_control(31,cleanup=True)
            else:
                self.reaper_control(26,0)
            self.reaper_area_held = False
            self.triggers = [False,False]
            self.sticks, self.next_repeat = [None,None],[0,0]
            self.motion_time, self.motion_credit = [None,None],[0,0]
            self.clear_dpad_navigation()
            # Deflected sticks/held buttons must not operate the new target.
            self.ready = False
            return True
        if self.e.BTN_EAST in pressed:
            self.reaper_area_cancelled = True
            self.reaper_control(31)
        if not self.reaper_area_cancelled:
            horizontal,vertical=self.config['chord_axes']
            directions=set()
            for axis,negative,positive in ((horizontal,'LEFT','RIGHT'),(vertical,'UP','DOWN')):
                value=self.raw_axes.get(axis,0)
                if value: directions.add(negative if value<0 else positive)
            if directions:
                self.navigate_dpad(directions,now)
            else:
                self.clear_dpad_navigation()
        return True

    def reaper_dialog_frame(self,pressed,released,now):
        """Use the native keyboard focus order in standard REAPER dialogs."""
        native_menu=self.mode=='reaper' and self.focused_reaper_menu()
        dialog=self.mode=='reaper' and (native_menu or self.focused_reaper_dialog())
        if dialog!=self.dialog_active or native_menu!=getattr(self,'menu_active',False):
            self.menu_active=native_menu
            self.dialog_active,self.dialog_ready=dialog,self.neutral()
            self.dialog_buttons.clear()
            self.dialog_direction,self.dialog_next=None,0
            self.pending_buttons.clear()
            self.button_since.clear()
            self.text_gesture.clear()
            self.select_gesture.clear()
            self.clear_dpad_navigation()
            self.write_keys(set())
            self.rotary_ready=self.transport_ready=False
            self.sticks,self.next_repeat=[None,None],[0,0]
            if self.reaper_area_held:
                self.reaper_control(31,cleanup=True)
                self.reaper_area_held=False
            if not dialog:
                self.ready=False
                self.triggers=[False,False]
                return True
        if not dialog:
            return False
        if not self.dialog_ready:
            self.write_keys(set())
            self.dialog_ready=self.neutral()
            return True
        modifiers=set()
        if self.triggers[0]:modifiers.add(self.e.KEY_LEFTSHIFT)
        if self.triggers[1]:modifiers.add(self.e.KEY_LEFTCTRL)
        desired=set(modifiers)
        for source,target in ((self.e.BTN_NORTH,self.e.KEY_BACKSPACE),(self.e.BTN_WEST,self.e.KEY_SPACE)):
            if source in self.raw_keys:desired.add(target)
        self.write_keys(desired)
        self.dialog_buttons.update(pressed & {self.e.BTN_SOUTH,self.e.BTN_EAST})
        for source,key in ((self.e.BTN_SOUTH,self.e.KEY_ENTER),(self.e.BTN_EAST,self.e.KEY_ESC)):
            if source in released and source in self.dialog_buttons:
                self.keyboard_shortcut(key,modifiers)
        self.dialog_buttons.difference_update(released)
        for source,back in ((self.config['previous_bumper'],True),(self.config['next_bumper'],False)):
            if source in pressed:
                self.keyboard_shortcut(self.e.KEY_LEFT if back else self.e.KEY_RIGHT,set()) if native_menu else self.keyboard_shortcut(self.e.KEY_TAB,{self.e.KEY_LEFTSHIFT} if back else set())
        # Menu keeps the ordinary launcher/legend behavior; all DAW actions and
        # Select+face shortcuts are suppressed until the dialog loses focus.
        menu={self.e.BTN_MODE}
        self.button_gestures(pressed & menu,released & menu,now,True)
        horizontal,vertical=self.config['chord_axes']
        directions=set()
        for axis,negative,positive in ((horizontal,'LEFT','RIGHT'),(vertical,'UP','DOWN')):
            value=self.raw_axes.get(axis,0)
            if value:directions.add(negative if value<0 else positive)
        if directions:self.navigate_dpad(directions,now)
        else:self.clear_dpad_navigation()
        x,y=(self.axis(code) for code in self.config['left_stick'])
        magnitude=max(abs(x),abs(y))
        if magnitude<=self.config['stick_release']:
            self.dialog_direction=None
        elif magnitude>=self.config['stick_press']:
            direction='left' if abs(x)>=abs(y) and x<0 else 'right' if abs(x)>=abs(y) else 'up' if y<0 else 'down'
            fresh=direction!=self.dialog_direction
            if fresh or now>=self.dialog_next:
                if native_menu:
                    self.keyboard_shortcut(getattr(self.e,'KEY_'+direction.upper()),set())
                else:
                    self.keyboard_shortcut(self.e.KEY_TAB,{self.e.KEY_LEFTSHIFT} if direction in ('up','left') else set())
                self.dialog_direction=direction
                self.dialog_next=now+(.35 if fresh else .16)
        return True

    def frame(self, pressed, released, now, active):
        if self.block_lid_input(active):
            return
        if self.mode_shortcut_frame(now, active):
            return
        if not self.permitted(active) or not self.grabbed or not self.ready:
            self.button_gestures(pressed, released, now, active)
            return
        previous_triggers = tuple(self.triggers)
        for index, name in enumerate(('shift_trigger', 'ctrl_trigger')):
            value = self.axis(self.config[name], True)
            threshold = self.config['trigger_release' if self.triggers[index] else 'trigger_press']
            self.triggers[index] = value > threshold
        if self.reaper_dialog_frame(pressed,released,now):
            return
        if self.reaper_area_frame(pressed,previous_triggers,now):
            return
        if self.mode == 'reaper' and tuple(self.triggers) != previous_triggers:
            self.reaper_control(22)
        selecting = self.select_shortcut_frame()
        desired = set()
        if not selecting:
            for button in (self.e.BTN_NORTH, self.e.BTN_WEST):
                if button in self.raw_keys and button in self.config['buttons']:
                    desired.add(self.config['buttons'][button])
        if not self.config['chords'] and not selecting:
            for source, (negative, positive) in self.config['dpad'].items():
                value = self.raw_axes.get(source, 0)
                if value:
                    desired.add(negative if value < 0 else positive)
        if self.triggers[0]:
            desired.add(self.e.KEY_LEFTSHIFT)
        if self.triggers[1]:
            desired.add(self.e.KEY_LEFTCTRL)
        self.write_keys(desired)
        self.button_gestures(pressed, released, now, active)
        if self.permitted(active) and self.grabbed and self.ready and not selecting:
            self.shortcut_frame(now)

    def select_shortcut_frame(self):
        """Select prefixes layout actions; X/Y otherwise remain immediate keys."""
        gesture = self.select_gesture
        if self.e.BTN_SELECT not in self.raw_keys and not gesture.previous:
            return False
        held = {name for name, symbol in FACE_NAMES.items() if getattr(self.e, symbol) in self.raw_keys}
        if self.e.BTN_SELECT in self.raw_keys:
            held.add('SELECT')
        horizontal, vertical = self.config['chord_axes']
        for axis, negative, positive in ((horizontal, 'LEFT', 'RIGHT'), (vertical, 'UP', 'DOWN')):
            value = self.raw_axes.get(axis, 0)
            if value:
                held.add(negative if value < 0 else positive)
        if not gesture.previous:
            self.select_in_legend = self.legend_open()
        # A face must be added after Select, never before or simultaneously.
        new_faces = (held & set(FACE_NAMES)) - (gesture.previous & set(FACE_NAMES))
        if (new_faces and 'SELECT' not in gesture.previous
                or held & {'UP', 'DOWN', 'LEFT', 'RIGHT'}
                or self.e.BTN_START in self.raw_keys
                or self.text_gesture.previous or self.dpad_navigation
                or self.select_in_legend != self.legend_open()):
            gesture.invalid = True
        self.text_gesture.clear()
        self.clear_dpad_navigation()
        captured = self.select_in_legend
        result = gesture.update(held)
        if not held:
            self.select_in_legend = False
        if result and not captured and not self.legend_open():
            action = (self.config['actions'].get(self.e.BTN_SELECT) if result == {'SELECT'}
                      else self.config['chords'].get(result))
            if action:
                self.dispatch(action)
        return True

    def clear_dpad_navigation(self):
        self.dpad_navigation = self.dpad_blocked = False
        self.dpad_direction = frozenset()
        self.dpad_since = self.dpad_time = None
        self.dpad_credit = 0

    def navigate_dpad(self, directions, now):
        """Emit explicit steps with a hold-speed ramp, never kernel auto-repeat."""
        directions = frozenset(directions)
        if directions != self.dpad_direction:
            self.dpad_direction = directions
            self.dpad_since = self.dpad_time = now
            self.dpad_credit = 0
            steps = 1
        else:
            start = max(self.dpad_time, now - .1,
                        self.dpad_since + self.config['dpad_repeat_delay'])
            self.dpad_time = now
            rates = self.config['dpad_line_rate' if directions & {'UP', 'DOWN'} else 'dpad_rate']
            low, high = rates

            def rate(at):
                elapsed = at - self.dpad_since - self.config['dpad_repeat_delay']
                return low + (high - low) * max(0, min(1, elapsed / self.config['dpad_acceleration_time']))

            self.dpad_credit += max(0, now - start) * (rate(start) + rate(now)) / 2
            steps = int(self.dpad_credit)
            self.dpad_credit -= steps
        modifiers = self.keys & {self.e.KEY_LEFTSHIFT, self.e.KEY_LEFTCTRL}
        reaper = self.mode == 'reaper' and not self.dialog_active and self.focused_reaper()
        for _ in range(steps):
            for direction in sorted(directions):
                horizontal, vertical = self.config['chord_axes']
                axis = horizontal if direction in ('LEFT', 'RIGHT') else vertical
                key = self.config['dpad'][axis][direction in ('RIGHT', 'DOWN')]
                extra = {self.e.KEY_LEFTCTRL, self.e.KEY_LEFTALT} if reaper and direction in ('UP', 'DOWN') else set()
                if reaper:
                    control = {'LEFT': 0, 'RIGHT': 1, 'UP': 2, 'DOWN': 3}[direction]
                    if self.reaper_area_held:
                        control += 27
                    elif self.triggers[1] and direction in ('LEFT', 'RIGHT'):
                        control += 24
                    self.reaper_control(control)
                else:
                    self.shortcut(key, modifiers | extra)

    def shortcut_frame(self, now):
        held = {name for name, code in self.config['chord_faces'].items() if code in self.raw_keys}
        horizontal, vertical = self.config['chord_axes']
        if self.config['chords']:
            for axis, negative, positive in ((horizontal, 'LEFT', 'RIGHT'), (vertical, 'UP', 'DOWN')):
                value = self.raw_axes.get(axis, 0)
                if value:
                    held.add(negative if value < 0 else positive)
        directions = held - set(self.config['chord_faces'])
        # Only an already-held face button may prefix a combo. Inputs first
        # observed together are consumed conservatively, without a shortcut.
        if self.config['chords'] and (self.dpad_navigation or directions and not self.text_gesture.previous):
            if not self.dpad_navigation:
                self.dpad_navigation = True
                self.gesture_in_legend = self.legend_open()
            if not held:
                self.clear_dpad_navigation()
                self.gesture_in_legend = False
            elif held - directions or self.gesture_in_legend != self.legend_open():
                self.dpad_blocked = True
            elif directions and not self.dpad_blocked:
                self.navigate_dpad(directions, now)
            return
        if held and not self.text_gesture.previous:
            self.gesture_in_legend = self.legend_open()
        # Every face in a multi-face prefix must precede the D-pad. Adding a
        # second face alongside/after a direction must not turn a desktop
        # gesture into a terminal command.
        faces = held & set(self.config['chord_faces'])
        previous_faces = self.text_gesture.previous & set(self.config['chord_faces'])
        previous_directions = self.text_gesture.previous - set(self.config['chord_faces'])
        if faces - previous_faces and (directions or previous_directions):
            self.text_gesture.invalid = True
        captured = self.gesture_in_legend
        gesture = self.text_gesture.update(held)
        if not held:
            self.gesture_in_legend = False
        if gesture is None:
            return
        if len(gesture) == 1:
            name = next(iter(gesture))
            if name in FACE_NAMES:
                key = self.config['buttons'][self.config['chord_faces'][name]]
            else:
                axis = horizontal if name in ('LEFT', 'RIGHT') else vertical
                key = self.config['dpad'][axis][name in ('RIGHT', 'DOWN')]
            self.shortcut(key, self.keys & {self.e.KEY_LEFTSHIFT, self.e.KEY_LEFTCTRL})
        elif not captured and not self.legend_open():
            action = self.config['chords'].get(gesture)
            if action:
                self.dispatch(action)

    def motion_steps(self, index, now, magnitude, fresh, rates):
        """Integrate stick speed so continuous movement is independent of polling rate."""
        previous, self.motion_time[index] = self.motion_time[index], now
        if fresh or previous is None:
            self.motion_credit[index] = 0
            return 1
        low, high = rates
        travel = max(0, min(1, (magnitude - self.config['stick_press']) /
                            max(1e-6, 1 - self.config['stick_press'])))
        rate = low + (high - low) * travel ** 2
        # Discard long scheduling gaps rather than delivering a backlog of selections.
        self.motion_credit[index] += min(.1, max(0, now - previous)) * rate
        steps = int(self.motion_credit[index])
        self.motion_credit[index] -= steps
        return steps

    def scroll(self, direction, steps):
        # Wheel events follow the pointer's existing position, like a mouse wheel.
        if not steps:
            return
        axis, precise, sign = {
            'up': (self.e.REL_WHEEL, self.e.REL_WHEEL_HI_RES, 1),
            'down': (self.e.REL_WHEEL, self.e.REL_WHEEL_HI_RES, -1),
            'left': (self.e.REL_HWHEEL, self.e.REL_HWHEEL_HI_RES, -1),
            'right': (self.e.REL_HWHEEL, self.e.REL_HWHEEL_HI_RES, 1),
        }[direction]
        held = set(self.keys)
        try:
            # Wheel gestures stay plain scrolling even when controller triggers are held.
            self.write_keys(held - {self.e.KEY_LEFTSHIFT, self.e.KEY_LEFTCTRL})
            # One detent is 120 high-resolution units, plus its legacy equivalent.
            # Keep wheel and modifier frames on the same evdev stream, in order.
            self.keyboard.write(self.e.EV_REL, precise, sign * steps * 120)
            self.keyboard.write(self.e.EV_REL, axis, sign * steps)
            self.keyboard.syn()
        finally:
            self.write_keys(held)

    def rotary_frame(self, x, y, now):
        try:
            path = self.directory / 'reaper-rotary-target'
            target = path.read_text().strip() if time.time() - path.stat().st_mtime < 1 else ''
        except OSError:
            target = ''
        magnitude = max(abs(x), abs(y))
        if target != self.rotary_target:
            self.rotary_target, self.rotary_ready = target, magnitude <= self.config['stick_release']
            self.rotary_value, self.rotary_time = None, float('-inf')
        if not target:
            return False
        if magnitude <= self.config['stick_release']:
            self.rotary_ready, self.rotary_value = True, None
            return True
        if not self.rotary_ready or magnitude < self.config['stick_press']:
            return True
        if not self.focused_reaper():
            self.rotary_ready = False
            return True
        angle = math.atan2(x, -y)
        limit = 3 * math.pi / 4
        if abs(angle) > limit + math.radians(3):  # Inactive bottom arc.
            return True
        value = max(0, min(16383, round((angle + limit) / (2 * limit) * 16383)))
        if value != self.rotary_value and now - self.rotary_time >= .02:
            self.reaper_control(20, value)
            self.rotary_value, self.rotary_time = value, now
        return True

    def tick(self, now, active):
        if not self.device:
            return
        if self.block_lid_input(active):
            return
        if not self.permitted(active):
            if self.grabbed or self.keys:
                self.ungrab()
            self.frame(set(), set(), now, active)
            return
        if not self.grabbed:
            try:
                self.device.grab()
                self.grabbed = True
                self.resync()
            except OSError:
                return
        if not self.ready:
            self.ready = self.neutral()
            return
        self.frame(set(), set(), now, active)
        if not self.ready or self.mode_gesture.previous or self.dialog_active:
            return
        for index, name in enumerate(('left_stick', 'right_stick')):
            if self.reaper_area_held and (index == 1 or self.reaper_area_cancelled):
                continue
            x, y = (self.axis(code) for code in self.config[name])
            magnitude = max(abs(x), abs(y))
            transport_field=''
            if index==1 and self.mode=='reaper':
                try:
                    path=self.directory/'reaper-transport-field'
                    transport_field=path.read_text().strip() if time.time()-path.stat().st_mtime<1 else ''
                except OSError: pass
                if transport_field!=self.transport_target:
                    self.transport_target=transport_field
                    self.transport_ready=magnitude<=self.config['stick_release']
                    self.sticks[index],self.next_repeat[index]=None,0
                if transport_field:
                    if magnitude<=self.config['stick_release']: self.transport_ready=True
                    if not self.transport_ready: continue
            if self.stick_pending[index]:
                self.sticks[index] = None
                self.motion_time[index], self.motion_credit[index] = None, 0
                self.next_repeat[index] = 0
                if magnitude <= self.config['stick_release']:
                    self.stick_modes[index], self.stick_pending[index] = self.stick_pending[index], None
                    self.publish_stick_mode()
                    if self.legend_open():
                        self.close_legend()
                        self.toggle_legend()
                continue
            if (index == 1 and self.mode == 'reaper' and self.stick_modes[index] == 'zoom'
                    and self.rotary_frame(x, y, now)):
                self.sticks[index] = None
                self.motion_time[index], self.motion_credit[index] = None, 0
                continue
            if magnitude <= self.config['stick_release']:
                self.sticks[index] = None
                self.motion_time[index], self.motion_credit[index] = None, 0
                continue
            if self.legend_open():
                self.motion_time[index], self.motion_credit[index] = None, 0
                continue
            # DAW gestures should not zoom a dialog's controls or a different
            # application. Window-management stick modes remain available.
            reaper = self.mode == 'reaper' and self.focused_reaper()
            direction = ('left' if x < 0 else 'right') if abs(x) >= abs(y) else ('up' if y < 0 else 'down')
            fresh = direction != self.sticks[index] and magnitude >= self.config['stick_press']
            mode = self.stick_modes[index]
            if mode in ('scroll', 'text', 'zoom'):
                if self.mode == 'reaper' and not reaper:
                    self.sticks[index] = None
                    self.motion_time[index], self.motion_credit[index] = None, 0
                    continue
                if not fresh and self.sticks[index] is None:
                    continue
                if not fresh:
                    direction = self.sticks[index]
                self.sticks[index] = direction
                rates = self.config['zoom_rate'] if mode == 'zoom' else self.config['scroll_rate'] if mode == 'scroll' else self.config[
                    'selection_line_rate' if direction in ('up', 'down') else 'selection_rate']
                try:
                    page_path=self.directory / 'reaper-page'
                    page=page_path.read_text().strip() if page_path.exists() else ''
                    mixer_navigation = reaper and (index == 1 and page == 'FX' or index == 0 and (self.reaper_area_held or
                        page in ('Mixer','FX','Toolbar','Transport')
                        or (self.directory / 'reaper-area').exists() and (self.directory / 'reaper-area').read_text().strip()))
                except OSError:
                    mixer_navigation = False
                transport_adjustment=reaper and index==1 and bool(transport_field)
                if mixer_navigation or transport_adjustment:
                    # Object selection needs a deliberate nudge, then bounded
                    # repeats rather than the continuous scrolling speed.
                    if not fresh and now < self.next_repeat[index]:
                        continue
                    steps = 1
                    self.next_repeat[index] = now + (.35 if fresh else .16)
                    self.motion_time[index], self.motion_credit[index] = None, 0
                else:
                    steps = self.motion_steps(index, now, magnitude, fresh, rates)
                if reaper:
                    offset = 27 if self.reaper_area_held else 4 if index == 0 else 8
                    for _ in range(steps):
                        self.reaper_control(offset + {'left': 0, 'right': 1, 'up': 2, 'down': 3}[direction])
                    continue
                if mode == 'scroll':
                    if reaper:
                        # Stock Alt+arrows scroll the REAPER viewport. Keyboard
                        # events carry modifier state reliably; its wheel
                        # handler can instead sample modifiers after release.
                        for _ in range(steps):
                            self.shortcut(getattr(self.e, 'KEY_' + direction.upper()), {self.e.KEY_LEFTALT})
                    else:
                        self.scroll(direction, steps)
                    continue
                if mode == 'zoom':
                    for _ in range(steps):
                        self.shortcut(getattr(self.e, REAPER_ZOOM[direction]), set())
                    continue
                modifiers = self.keys & {self.e.KEY_LEFTSHIFT, self.e.KEY_LEFTCTRL}
                if reaper and direction in ('up', 'down'):
                    modifiers |= {self.e.KEY_LEFTCTRL, self.e.KEY_LEFTALT}
                for _ in range(steps):
                    self.shortcut(getattr(self.e, 'KEY_' + direction.upper()), modifiers)
                continue
            if not fresh and (self.sticks[index] is None or now < self.next_repeat[index]):
                continue
            if not fresh:
                direction = self.sticks[index]
            self.sticks[index] = direction
            self.next_repeat[index] = now + self.config['repeat_delay' if fresh else 'repeat_interval']
            if mode == 'windows':
                self.command(('move' if self.triggers[0] else 'focus') + ' ' + direction)
            elif not self.legend_open():
                action = 'grow' if direction in ('right', 'down') else 'shrink'
                dimension = 'width' if direction in ('left', 'right') else 'height'
                self.command(f"resize {action} {dimension} {self.config['resize_step']} ppt")

    def status(self, active):
        return {'mode': self.mode, 'dialog_active': self.dialog_active, 'session_active': active, 'lid_closed': self.lid_closed(), 'paused': (self.directory / 'paused').exists(),
                'device': self.device.path if self.device else None,
                'device_name': self.device.name if self.device else None,
                'grabbed': self.grabbed, 'ready': self.ready, 'keys': sorted(self.keys),
                'stick_modes': dict(zip(('left', 'right'), self.stick_modes)),
                'stick_pending': dict(zip(('left', 'right'), self.stick_pending)),
                'legend_open': self.legend_open(),
                'axis_ranges': self.ranges, 'actions': list(self.actions), 'reason': self.reason,
                'unavailable_actions': self.unavailable_actions}


def output_capabilities(config, codes):
    keys = set()
    for profile in (config, *config.get('profiles', {}).values()):
        keys.update(profile['buttons'].values())
        keys.update(key for values in profile['dpad'].values() for key in values)
    keys |= {codes.KEY_LEFTSHIFT, codes.KEY_LEFTCTRL, codes.KEY_LEFTMETA,codes.KEY_TAB}
    keys |= {getattr(codes, name) for key, modifiers in KEY_ACTIONS.values() for name in (key, *modifiers)}
    keys |= {getattr(codes, name) for name in REAPER_ZOOM.values()}
    # Mouse classification requires X/Y and a mouse button even though this mapper
    # emits only wheel movement. No pointer movement or mouse clicks are generated.
    keys.add(codes.BTN_LEFT)
    return {codes.EV_KEY: sorted(keys), codes.EV_REP: [],
            codes.EV_REL: [codes.REL_X, codes.REL_Y, codes.REL_WHEEL, codes.REL_HWHEEL,
                           codes.REL_WHEEL_HI_RES, codes.REL_HWHEEL_HI_RES]}


def discover(config, evdev):
    matches = []
    required_axes = set(config['left_stick'] + config['right_stick'] + list(config['dpad']) +
                        [config['shift_trigger'], config['ctrl_trigger']])
    required_keys = set(config['buttons']) | {config['previous_bumper'], config['next_bumper']} | {evdev.ecodes.BTN_START}
    for path in evdev.list_devices():
        device = None
        try:
            device = evdev.InputDevice(path)
            capabilities = device.capabilities(absinfo=False)
            selector = config['device']
            selected = all((device.name if key == 'name' else getattr(device.info, key)) == value
                           for key, value in selector.items())
            if (selected and required_axes <= set(capabilities.get(evdev.ecodes.EV_ABS, []))
                    and required_keys <= set(capabilities.get(evdev.ecodes.EV_KEY, []))
                    and all(device.absinfo(code).max > device.absinfo(code).min for code in required_axes)):
                matches.append(device)
                device = None
        except (OSError, ValueError):
            pass
        finally:
            if device:
                device.close()
    if len(matches) == 1:
        return matches[0], 'Controller selected'
    for device in matches:
        device.close()
    return None, 'Several controllers match; set device in your profile' if matches else 'Waiting for a compatible, accessible controller'


def client(directory, command):
    if command in ('pause', 'resume'):
        marker = directory / 'paused'
        marker.touch() if command == 'pause' else marker.unlink(missing_ok=True)
    try:
        with socket.socket(socket.AF_UNIX) as sock:
            sock.settimeout(2)
            sock.connect(str(directory / 'control.sock'))
            sock.sendall((json.dumps({'command': command}) + '\n').encode())
            print(sock.makefile().readline().strip())
    except (FileNotFoundError, ConnectionRefusedError):
        if command not in ('pause', 'resume'):
            raise SystemExit('Gamepad mapper is not running in this session')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_mutually_exclusive_group()
    for name in ('toggle', 'status', 'pause', 'resume'):
        commands.add_argument('--' + name, action='store_true')
    parser.add_argument('--config', type=Path, help='Personal profile overrides')
    args = parser.parse_args()
    logging.basicConfig(level=logging.INFO, format='%(message)s')
    if os.geteuid() == 0:
        raise SystemExit('Run this mapper as your normal graphical session user')
    directory = runtime()
    command = next((name for name in ('toggle', 'status', 'pause', 'resume') if getattr(args, name)), None)
    if command:
        client(directory, command)
        return
    if not os.environ.get('SWAYSOCK'):
        raise SystemExit('Start the mapper inside Sway')
    import evdev
    config = configuration(args.config, evdev.ecodes)
    session = Session()
    with (directory / 'mapper.lock').open('w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise SystemExit('A mapper is already running')
        with evdev.UInput(output_capabilities(config, evdev.ecodes),
                          name='Minion gamepad keyboard', phys='minion/gamepad-keyboard', vendor=0x1209, product=2) as keyboard:
            mapper = Mapper(config, keyboard, evdev.ecodes, directory)
            server = socket.socket(socket.AF_UNIX)
            path = directory / 'control.sock'
            path.unlink(missing_ok=True)
            server.bind(str(path))
            path.chmod(0o600)
            server.listen(4)
            signal.signal(signal.SIGTERM, lambda *_: setattr(mapper, 'running', False))
            signal.signal(signal.SIGINT, lambda *_: setattr(mapper, 'running', False))
            next_scan, previous_reason = 0, None
            dropped = False
            pressed = set()
            released = set()
            try:
                while mapper.running:
                    now, active = time.monotonic(), session.active()
                    if not mapper.device and active and now >= next_scan:
                        device, mapper.reason = discover(config, evdev)
                        next_scan = now + .5
                        if mapper.reason != previous_reason:
                            log.info(mapper.reason)
                            previous_reason = mapper.reason
                        if device:
                            mapper.attach(device)
                    readable, _, _ = select.select([server] + ([mapper.device] if mapper.device else []), [], [], .03)
                    if server in readable:
                        connection, _ = server.accept()
                        with connection:
                            connection.settimeout(1)
                            try:
                                with connection.makefile('rwb') as stream:
                                    request = json.loads(stream.readline(1024))
                                    if request['command'] == 'toggle':
                                        mapper.toggle()
                                    elif request['command'] in ('pause', 'resume'):
                                        marker = directory / 'paused'
                                        marker.touch() if request['command'] == 'pause' else marker.unlink(missing_ok=True)
                                        mapper.ungrab()
                                    elif request['command'] != 'status':
                                        raise ValueError('Unknown command')
                                    stream.write((json.dumps(mapper.status(active)) + '\n').encode())
                                    stream.flush()
                            except (OSError, ValueError, KeyError) as error:
                                log.warning('Control request failed: %s', error)
                    if mapper.device in readable:
                        try:
                            for event in mapper.device.read():
                                if event.type == evdev.ecodes.EV_SYN and event.code == evdev.ecodes.SYN_DROPPED:
                                    mapper.reset()
                                    dropped = True
                                elif event.type == evdev.ecodes.EV_SYN and event.code == evdev.ecodes.SYN_REPORT:
                                    if dropped:
                                        mapper.resync()
                                        dropped = False
                                    else:
                                        mapper.frame(pressed, released, now, active)
                                    pressed.clear()
                                    released.clear()
                                elif not dropped and event.type == evdev.ecodes.EV_KEY:
                                    if event.value:
                                        mapper.raw_keys.add(event.code)
                                        if event.value == 1:
                                            pressed.add(event.code)
                                    else:
                                        mapper.raw_keys.discard(event.code)
                                        released.add(event.code)
                                elif not dropped and event.type == evdev.ecodes.EV_ABS:
                                    mapper.raw_axes[event.code] = event.value
                        except OSError:
                            mapper.detach()
                            pressed.clear()
                            released.clear()
                            dropped = False
                    mapper.tick(time.monotonic(), active)
            finally:
                mapper.detach()
                server.close()
                path.unlink(missing_ok=True)


if __name__ == '__main__':
    main()
