#!/usr/bin/python3
"""Compact Sway bar status, using the desktop's existing system services."""
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime
import html
import http.client
import json
import math
import os
from pathlib import Path
import re
import subprocess
import sys
import threading
import time


def run(*command):
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=1,
                                env={**os.environ, 'LC_ALL': 'C'})
        return result.stdout.strip() if result.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired, UnicodeError):
        return None


def read(path):
    try:
        return path.read_text().strip()
    except (OSError, UnicodeError):
        return ''


def block(name, text, short=None):
    result = {'name': name, 'full_text': text}
    if short:
        result['short_text'] = short
    return result


def batteries(root=Path('/sys/class/power_supply')):
    result = []
    for supply in sorted(root.glob('*')):
        if (read(supply / 'type') != 'Battery' or read(supply / 'scope') == 'Device'
                or read(supply / 'present') not in ('', '1')):
            continue
        capacity = read(supply / 'capacity')
        if not re.fullmatch(r'[0-9]{1,3}', capacity) or int(capacity) > 100:
            continue
        suffix = {'Charging': ' ↑', 'Discharging': ' ↓', 'Full': ' Full',
                  'Not charging': ' Idle'}.get(read(supply / 'status'), ' ?')
        indicator = block('battery', f'{int(capacity)}%{suffix}')
        indicator['instance'] = supply.name
        result.append(indicator)
    return result


def wifi():
    # Cached access points only: status polling must never trigger a scan.
    output = run('nmcli', '-t', '--escape', 'no', '-f', 'IN-USE,SIGNAL,SSID',
                 'device', 'wifi', 'list', '--rescan', 'no')
    if output is None:
        return block('wifi', 'Wi-Fi ?'), 'Wi-Fi status is unavailable'
    for line in output.splitlines():
        fields = line.split(':', 2)
        if len(fields) == 3 and fields[0] == '*':
            signal, ssid = fields[1:]
            strength = signal + '%' if signal.isdecimal() and 0 <= int(signal) <= 100 else 'ON'
            return block('wifi', 'Wi-Fi ' + strength), ssid or 'Hidden network'
    return block('wifi', 'Wi-Fi disconnected', 'Wi-Fi OFF'), 'Wi-Fi is disconnected'


def audio():
    output = run('wpctl', 'get-volume', '@DEFAULT_AUDIO_SINK@')
    if output is None:
        return block('audio', 'Vol ?')
    match = re.fullmatch(r'Volume:\s+([0-9]+(?:\.[0-9]+)?)(\s+\[MUTED\])?', output)
    if not match:
        return block('audio', 'Vol ?')
    volume = float(match[1])
    if not math.isfinite(volume * 100):
        return block('audio', 'Vol ?')
    return block('audio', 'Muted' if match[2] else f'Vol {int(volume * 100 + .5)}%')


def proxy():
    output = run('systemctl', 'show', '-p', 'LoadState', '-p', 'ActiveState', 'minion-proxy.service')
    if output is None:
        return block('proxy', 'Proxy ?')
    values = dict(line.split('=', 1) for line in output.splitlines() if '=' in line)
    if values.get('LoadState') == 'not-found':
        state = 'N/A'
    else:
        state = {'active': 'ON', 'reloading': 'ON', 'inactive': 'OFF', 'failed': 'FAIL',
                 'activating': 'START', 'deactivating': 'STOP'}.get(values.get('ActiveState'), '?')
    return block('proxy', 'Proxy ' + state)


def hhd_state(token_path=Path('/tmp/hhd/token')):
    token = read(token_path)
    if not re.fullmatch(r'[a-zA-Z0-9]{1,128}', token):
        return None
    # Connect directly: proxy environment variables and redirects must never
    # send the local control token elsewhere. This endpoint is read-only.
    connection = http.client.HTTPConnection('127.0.0.1', 5335, timeout=1)
    try:
        connection.request('GET', '/api/v1/state', headers={'Authorization': 'Bearer ' + token})
        response = connection.getresponse()
        if response.status != 200:
            return None
        data = response.read(256 * 1024 + 1)
        if len(data) > 256 * 1024:
            return None
        state = json.loads(data)
        return state if isinstance(state, dict) else None
    except (OSError, ValueError, http.client.HTTPException):
        return None
    finally:
        connection.close()


def nested(data, *keys):
    for key in keys:
        if not isinstance(data, dict):
            return None
        data = data.get(key)
    return data


def power():
    state = hhd_state()
    enabled = nested(state, 'hhd', 'settings', 'tdp_enable')
    if enabled is False:
        return block('power', 'Auto'), 'HHD TDP overrides are disabled; the existing power policy is in control.'
    if enabled is not True or nested(state, 'hhd', 'settings', 'tdp_ready') is not True:
        return block('power', 'Power ?'), 'HHD power controls are unavailable or not ready.'
    # WIN Mini's steady APU target. Prefer the detailed control over the QAM
    # slider, since a user can edit the detailed value separately.
    for keys in (('tdp', 'smu', 'std', 'skin_limit'), ('tdp', 'smu', 'std', 'stapm_limit'),
                 ('tdp', 'qam', 'tdp')):
        value = nested(state, *keys)
        if type(value) in (int, float) and 0 < value <= 200 and math.isfinite(value):
            label = f'Limit {value:g}W'
            return block('power', label), label + ' is the configured APU target, not measured consumption or verified hardware readback.'
    return block('power', 'Limit ?'), 'HHD TDP controls are enabled, but no supported APU target is available.'


def temperature_value(path, divisor):
    raw = read(path)
    if not re.fullmatch(r'-?[0-9]{1,7}', raw):
        return None
    value = int(raw) / divisor
    return value if -40 <= value <= 150 else None


def temperatures(hwmon=Path('/sys/class/hwmon'), supplies=Path('/sys/class/power_supply')):
    sensors, seen = [], set()
    for device in sorted(hwmon.glob('hwmon*')):
        driver = read(device / 'name')
        for path in sorted(device.glob('temp[0-9]*_input')):
            channel = path.name.removesuffix('_input')
            if (read(device / (channel + '_fault')) == '1'
                    or read(device / (channel + '_enable')) == '0'):
                continue
            value = temperature_value(path, 1000)
            try:
                identity = path.resolve()
            except (OSError, RuntimeError):
                continue  # A disappearing device or broken class symlink.
            if value is None or identity in seen:
                continue
            seen.add(identity)
            label = read(device / (channel + '_label')) or channel
            group, priority = '', 2
            if driver == 'k10temp':
                group = 'CPU' if label == 'Tdie' else 'Ctl' if label == 'Tctl' else ''
                priority = 0 if label == 'Tdie' else 1
            elif driver == 'amdgpu':
                group = 'GPU'
                priority = 0 if label.lower() == 'edge' else 1
            elif driver == 'nvme':
                group = 'SSD'
                priority = 0 if label.lower() == 'composite' else 1
            sensors.append((group, priority, value, f'{driver or "hwmon"} {device.name} / {label}'))
    for supply in sorted(supplies.glob('*')):
        if (read(supply / 'type') != 'Battery' or read(supply / 'scope') == 'Device'
                or read(supply / 'present') not in ('', '1')):
            continue
        # power_supply temperatures use tenths of a degree, unlike hwmon.
        value = temperature_value(supply / 'temp', 10)
        if value is not None:
            sensors.append(('Bat', 0, value, f'{supply.name} / battery'))
    if not sensors:
        return [], 'No readable temperature sensors are available.'
    summaries = []
    # Prefer die temperature to Tctl, but keep both in the full sensor list.
    for group in ('CPU' if any(s[0] == 'CPU' for s in sensors) else 'Ctl', 'GPU', 'SSD', 'Bat'):
        candidates = [s for s in sensors if s[0] == group]
        if candidates:
            priority = min(s[1] for s in candidates)
            value = max(s[2] for s in candidates if s[1] == priority)
            summaries.append(f'{group}{value:.0f}°')
    if not summaries:
        summaries = [f'Temp{max(s[2] for s in sensors):.0f}°']
    details = '\n'.join(f'{s[3]}: {s[2]:.1f} °C' for s in sensors)
    return [block('temperatures', ' '.join(summaries), summaries[0])], details


def health():
    return power(), temperatures()


def launch_power_controls():
    try:
        subprocess.Popen(['minion-hhd-ui'], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


def launch_network_controls():
    try:
        subprocess.Popen(['nm-connection-editor'], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


def launch_proxy_controls():
    try:
        subprocess.Popen(['minion-proxy-ui'], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


def launch_voice_controls(action):
    try:
        subprocess.Popen(['minion-voice', action], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


def launch_battery_statistics(instance=None):
    command = ['gnome-power-statistics']
    if isinstance(instance, str) and re.fullmatch(r'[A-Za-z0-9_]+', instance):
        command.append('--device=/org/freedesktop/UPower/devices/battery_' + instance)
    try:
        subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        return
    # Also bring an already open window forward, across workspaces/fullscreen.
    for _ in range(20):
        result = run('swaymsg', '-r', '[app_id="^(gnome-power-statistics|org.gnome.PowerStats)$"] focus')
        try:
            replies = json.loads(result or 'null')
            if isinstance(replies, list) and replies and all(r.get('success') for r in replies):
                return
        except (ValueError, AttributeError):
            pass
        time.sleep(.05)


def keyboard_layout():
    output = run('swaymsg', '-r', '-t', 'get_inputs')
    try:
        inputs = json.loads(output or 'null')
    except ValueError:
        return []
    if not isinstance(inputs, list):
        return []
    keyboards = [item for item in inputs if isinstance(item, dict) and item.get('type') == 'keyboard'
                 and item.get('name') != 'Minion gamepad keyboard']
    physical = [item for item in keyboards if item.get('vendor', 0)]
    layouts = []
    for item in physical or keyboards:
        if len(item.get('xkb_layout_names') or []) < 2:
            continue
        name = item.get('xkb_active_layout_name')
        if isinstance(name, str) and name and name not in layouts:
            layouts.append(name)
    codes = {'English (US)': 'US', 'English (UK)': 'UK', 'Russian': 'RU',
             'German': 'DE', 'French': 'FR', 'Spanish': 'ES', 'Ukrainian': 'UA'}
    if not layouts:
        return []
    label = '/'.join(codes.get(name, name) for name in layouts)
    return [block('layout', label, label[:12])]


def stick_mode():
    directory = os.environ.get('XDG_RUNTIME_DIR')
    mode = read(Path(directory) / 'minion-gamepad/stick-mode') if directory else ''
    labels = {f'L:{left} R:{right}': f'L:{left[0]} R:{right[0]}'
              for left in ('Scroll', 'Text') for right in ('Windows', 'Resize')}
    labels.update({f'REAPER L:{left} R:{right}': f'RP L:{left[0]} R:{right[0]}'
                   for left in ('Scroll', 'Text') for right in ('Zoom', 'Windows')})
    labels['Gamepad'] = 'Pad'
    if mode == 'REAPER controls':
        page = read(Path(directory) / 'minion-gamepad/reaper-page')
        return block('stick', 'RP:' + (page if page in ('Arrange', 'Mixer', 'FX') else 'Waiting'))
    return block('stick', labels.get(mode, 'L:S R:W'))


def refresh_rate():
    try:
        outputs = json.loads(run('swaymsg', '-r', '-t', 'get_outputs') or 'null')
        if isinstance(outputs, list):
            for output in outputs:
                if isinstance(output, dict) and output.get('name') == 'eDP-1' and output.get('active'):
                    rate = output.get('current_mode', {}).get('refresh')
                    if isinstance(rate, (int, float)) and not isinstance(rate, bool) and 0 < rate < 1000000:
                        return block('refresh', f'{rate / 1000:.0f}Hz')
    except (ValueError, TypeError, AttributeError):
        pass
    return block('refresh', 'Hz ?')


def awake_mode():
    directory = os.environ.get('XDG_RUNTIME_DIR')
    enabled = bool(directory) and read(Path(directory) / 'minion-idle/keep-awake') == '1'
    result = block('awake', 'Awake ON' if enabled else 'Awake OFF', 'Awake' if enabled else 'Idle')
    if enabled:
        result['color'] = '#9ece6a'
    return result


def voice_mode():
    directory = os.environ.get('XDG_RUNTIME_DIR')
    state = read(Path(directory) / 'voxtype/state') if directory else ''
    labels = {'idle': 'Mic', 'recording': 'Mic REC', 'transcribing': 'Mic …', 'outputting': 'Mic …'}
    result = block('voice', labels.get(state, 'Mic OFF'))
    if state == 'recording':
        result['color'] = '#f7768e'
    elif state in ('transcribing', 'outputting'):
        result['color'] = '#e0af68'
    return result


def clicks(details):
    for line in sys.stdin:
        try:
            event = json.loads(line.strip().lstrip(','))
        except ValueError:
            continue  # Opening bracket of the click-event stream.
        if not isinstance(event, dict):
            continue
        name, button = event.get('name'), event.get('button')
        if name == 'power' and button == 1:
            launch_power_controls()
        elif name == 'awake' and button == 1:
            run('minion-idle-controls', 'toggle-awake')
        elif name == 'wifi' and button == 1:
            launch_network_controls()
        elif name == 'proxy' and button == 1:
            launch_proxy_controls()
        elif name == 'battery' and button == 1:
            launch_battery_statistics(event.get('instance'))
        elif name == 'voice' and button in (1, 3):
            launch_voice_controls('toggle' if button == 1 else 'cancel')
        elif (name == 'temperatures' and button == 1) or (name in ('wifi', 'power') and button == 3):
            title = {'wifi': 'Wi-Fi', 'temperatures': 'Temperatures', 'power': 'Power controls'}[name]
            run('notify-send', '-a', 'minion', '--', title, html.escape(details.get(name, 'Status is unavailable')))


def main():
    details = {}
    threading.Thread(target=clicks, args=(details,), daemon=True).start()
    print(json.dumps({'version': 1, 'click_events': True}) + '\n[', flush=True)
    network, service = block('wifi', 'Wi-Fi ?'), block('proxy', 'Proxy ?')
    power_block, thermal_blocks = block('power', 'Power ?'), []
    next_slow = 0
    with ThreadPoolExecutor(max_workers=6) as workers:
        while True:
            started = time.monotonic()
            volume = workers.submit(audio)
            layout = workers.submit(keyboard_layout)
            refresh = workers.submit(refresh_rate)
            slow = started >= next_slow
            if slow:
                network_future = workers.submit(wifi)
                service_future = workers.submit(proxy)
                health_future = workers.submit(health)
            blocks = [stick_mode(), refresh.result(), awake_mode(), voice_mode()]
            blocks += layout.result()
            if slow:
                network, details['wifi'] = network_future.result()
                service = service_future.result()
                (power_block, details['power']), (thermal_blocks, details['temperatures']) = health_future.result()
                next_slow = started + 5
            blocks += [power_block] + thermal_blocks + [network, volume.result(), service] + batteries()
            # Pick up timezone changes without restarting the desktop/bar.
            time.tzset()
            now = datetime.now()
            blocks.append(block('clock', now.strftime('%a %d %b %H:%M'), now.strftime('%H:%M')))
            print(json.dumps(blocks, ensure_ascii=False) + ',', flush=True)
            time.sleep(max(0, 1 - (time.monotonic() - started)))


if __name__ == '__main__':
    try:
        main()
    except (BrokenPipeError, KeyboardInterrupt):
        pass
